# List files or directories below to ignore them when running force:source:push, force:source:pull, and force:source:status
# More information: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
#

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

node_modules/

# Data Cloud / CDP metadata
**/activationPlatforms/**
**/dataSourceObjects/**
**/dataSourceTenants/**
**/dataStreamDefinitions/**
**/fieldSrcTrgtRelationships/**
**/internalDataConnectors/**
**/mktDataSources/**
**/mktDataTranObjects/**
**/objectSourceTargetMaps/**

# Org-level metadata we don't want to track
**/appMenus/**
**/authproviders/**
**/objects/**__dll/**
**/permissionsetgroups/**

# Non-project permissionsets
**/permissionsets/NextGen_*
**/permissionsets/sfdcInternalInt__*

# Runtime artifacts auto-generated by "sf agent publish" — never in source.
**/genAiPlannerBundles/**
**/bots/**

# Globe demo monitor (UIBundle) — EXCLUDED from the blanket force-app deploy so
# Tier 1 never tries to deploy an unbuilt bundle (dist/ is gitignored) or the
# CustomApplication that references it (deploying the app without the bundle
# errors "forceignored but is required"). install.sh Tier 4 (--with-globe)
# builds the bundle, then temporarily neutralizes THIS block (it restores it
# after) to deploy the whole set. Keep these four lines together as one block
# ended by a blank line — Tier 4's strip keys on the comment + the blank line.
**/uiBundles/SkywaveGlobe/**
**/uiBundles/SkywaveGlobe
**/applications/Skywave_Globe.app-meta.xml
**/permissionsets/Skywave_Globe_App.permissionset-meta.xml
**/cspTrustedSites/Skywave_Globe_Relay_Wss.cspTrustedSite-meta.xml

# Vendored observability QBrix (vendor/sdo-agentforce-observability) — re-include
# the Data Cloud types the global rules above ignore. In force-app those rules
# drop auto-retrieved DC junk; in the vendored dir these ARE source we deploy.
!vendor/sdo-agentforce-observability/**/dataSourceObjects/**
!vendor/sdo-agentforce-observability/**/mktDataSources/**
