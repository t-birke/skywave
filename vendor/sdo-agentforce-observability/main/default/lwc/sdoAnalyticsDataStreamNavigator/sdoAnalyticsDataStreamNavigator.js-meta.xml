<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="buttonLabel" type="String" label="Button Label" default="View Data Stream"
                description="The label text for the navigation button"/>
            <property name="streamName" type="String" label="Data Stream Name" required="true"
                description="The Name of the Data Stream to navigate to"/>
        </targetConfig>
    </targetConfigs>
    <masterLabel>Data Stream Navigator</masterLabel>
</LightningComponentBundle>
