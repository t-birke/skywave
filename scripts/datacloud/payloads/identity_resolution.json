            "partyType": "CookieId"
          },
          "shouldMatchOnBlank": false,
          "targetEntityName": "ssot__Individual__dlm",
          "targetFieldName": "AnonymousId__c"
        }
      ],
      "label": "Match by AnonymousId"
    }
  ],
