{
  "label": "Skywave Unified Individual",
  "description": "Exact-match IR for RTDG. Match by email or AnonymousId (cross-DMO).",
  "configurationType": "individual",
  "dataSpaceName": "default",
  "doesRunAutomatically": false,
  "matchRules": [
    {
      "criteria": [
        {
          "caseSensitiveMatch": false,
          "entityName": "ssot__ContactPointEmail__dlm",
