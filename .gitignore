# Local scratch/test output
/tmp/
nanobanana-output/
brochure/

# Finder copy/paste duplicates — never commit
**/*\ copy.*
**/*\ copy\ [0-9]*.*

# Secrets — never commit anything matching these
.secrets/
secrets/
.env
.env.*
!.env.example
.heroku/
*.pem
*.key
*.p12
*.jks
*.pfx

# Stashed observability seed data (demo data export)
.stash/

# Observability dataset export — build artifact, not source
skywave-observability-dataset/
skywave-observability-dataset.zip

# ECv2 reference raw assets are Salesforce "Company Confidential" minified
# files — never commit them (repo is planned to go public). We keep only our
# own DERIVED notes/values: the markdown docs + keyframes-decoded.css.
docs/ecv2-reference/raw-assets/home_view*.js
docs/ecv2-reference/raw-assets/init.min.js
docs/ecv2-reference/raw-assets/init.min.css
docs/ecv2-reference/raw-assets/embedded-messaging-styling.min.css
docs/ecv2-reference/raw-assets/iframe-shell.html
docs/ecv2-reference/raw-assets/*-extract.txt
