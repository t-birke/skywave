<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Skywave Seat Map Renderer</masterLabel>
    <description>Interactive seat-map in chat. Confirm seat calls Skywave_ChangeSeat imperatively then cues "seat change confirmed"; Abort collapses the card and cues "seat change aborted".</description>
    <targets>
        <target>lightning__AgentforceOutput</target>
        <target>lightning__AgentforceInput</target>
        <target>lightningSnapin__ChatMessage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AgentforceOutput">
            <sourceType name="c__SkywaveSeatMap"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
