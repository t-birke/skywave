<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Skywave Rental Payment Renderer</masterLabel>
    <description>Payment picker (Apple Pay / Credit Card / Demo Pay) for a rental booking. Demo Pay calls Skywave_ProcessRentalPayment imperatively; the other two show a demo-only hint. Cues the agent with "Rental payment completed" on success.</description>
    <targets>
        <target>lightning__AgentforceOutput</target>
        <target>lightning__AgentforceInput</target>
        <target>lightningSnapin__ChatMessage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AgentforceOutput">
            <sourceType name="c__SkywaveRentalPayment"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
