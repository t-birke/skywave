<?xml version="1.0" encoding="UTF-8"?>
<!--
  Permission set for the Site Guest User of the ESW deployment that backs
  ECv2 chat sessions on Skywave.

  Runtime context (empirically verified, internal Salesforce confirmation):
    ECv2 iframes its own LWR embedded-service site for security/public-access
    purposes. ALL client-side @AuraEnabled / @wire calls from CLT renderer
    LWCs run as that site's Guest User — NOT the per-session messaging end
    user, NOT the EinsteinAgentUser, NOT Automated Process. The deployment's
    site is auto-provisioned with name `ESW_SDO_Messaging_for_Web_*`.

  Backend Apex executed by the agent (e.g. Skywave_PresentProfileForm) runs
  as the EinsteinAgentUser and is unaffected by this permset.

  Manual assignment step (one-time per org):
    1. Find the ESW site backing the Skywave deployment:
         SELECT GuestUserId FROM Site WHERE Name LIKE 'ESW_SDO_Messaging_for_Web_%'
    2. Assign this permset to that GuestUserId. Either:
       a. UI: Setup -> Permission Sets -> Skywave Embedded Messaging
          -> Manage Assignments -> Add the guest user, OR
       b. CLI: sf data create record -o <org> -s PermissionSetAssignment \
              -v "AssigneeId=<guestUserId> PermissionSetId=<permsetId>"

  Class-access only — no object/field perms needed because Skywave_SaveProfile
  runs `without sharing` and does not enforce FLS/CRUD inline.
  Defense in depth: anonymous traffic can only invoke the two whitelisted
  classes; both validate and gate every write themselves.
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Apex class access the Messaging End User needs to run imperative LWC calls inside the Skywave embedded chat iframe (profile form save).</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Skywave Embedded Messaging</label>
    <classAccesses>
        <apexClass>Skywave_SaveProfile</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>Skywave_ProfileFormData</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
