        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>Skywave_RestUtil</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <!-- Proof-gated /api/website/contact/upsert forwards to Skywave_ContactUpsert
             as the integration user, so it needs the class (previously only the
             site guest user had it) + Create on the event it publishes below. -->
        <apexClass>Skywave_ContactUpsert</apexClass>
        <enabled>true</enabled>
    </classAccesses>
