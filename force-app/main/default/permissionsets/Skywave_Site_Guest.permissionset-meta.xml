<?xml version="1.0" encoding="UTF-8"?>
<!--
  Permission set for the skywave_api Site Guest User. Grants the bare
  minimum needed for the public REST endpoint:
    - Apex class access on Skywave_ContactUpsert (executes the endpoint)
    - Apex class access on Skywave_RestUtil (parseBody helper)
    - Create + Read on Skywave_Contact_Update__e (publish the event)

  No Contact perms — the trigger upserts the Contact in System Mode.
  Defense in depth: anonymous traffic can publish the event but cannot
  directly read or write Contacts.
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Apex + Platform Event publish for the skywave_api site guest user. Anonymous-traffic-safe.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Skywave Site Guest</label>
    <classAccesses>
        <apexClass>Skywave_ContactUpsert</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>Skywave_RestUtil</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Skywave_Contact_Update__e</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
