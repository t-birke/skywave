<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>STUB (mock): Sourcing pipeline — failure branch. Background step reached when the bid evaluation returns no qualified supplier (leading score below the award threshold). Records why the sourcing round was cancelled and recommends how to re-scope the RFP before re-running. Deterministic mock output; does not write to the record.</description>
    <environments>Default</environments>
    <interviewLabel>Sourcing Cancel {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Skywave Sourcing - Cancel (No Qualified Bid)</label>
    <processType>AutoLaunchedFlow</processType>
    <assignments>
        <name>Record_Cancellation</name>
        <label>Record Cancellation (mock)</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignmentItems>
            <assignToReference>out_CancellationReason</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No supplier cleared the award threshold — the leading bid scored {!inp_LeadingScore} against a required minimum of 75. Sourcing round for the {!inp_Season} season has been cancelled without an award.</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>out_Recommendation</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Re-scope before re-running: (1) widen the supplier panel beyond the current shortlist, (2) relax the sustainability weighting from 20% to 15% to admit lower-cost bidders, and (3) extend the RFP response window by two weeks to attract stronger submissions.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Record_Cancellation</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>inp_Season</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inp_LeadingScore</name>
        <dataType>Number</dataType>
        <scale>1</scale>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inp_Shortlist</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>out_CancellationReason</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>out_Recommendation</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
