<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>MOCK Flow Orchestration: Skywave Airlines seasonal sourcing / strategic-purchasing pipeline. A 7-step procurement process across 5 stages that mixes automated background work with human review, and includes one subprocess that hands over to a prompt template (RFP drafting) and one that hands over to an Agentforce agent (supplier negotiation). All steps call stub subflows so the orchestration runs end-to-end without external systems.</description>
    <environments>Default</environments>
    <interviewLabel>Skywave Sourcing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Skywave Sourcing</label>
    <processType>Orchestrator</processType>
    <orchestratedStages>
        <name>Stage_1_Plan_And_Draft</name>
        <label>1. Plan Demand and Draft RFP</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Stage_2_Issue_RFP</targetReference>
        </connector>
        <stageSteps>
            <name>Step_Demand_Forecast</name>
            <label>Build Demand Forecast</label>
            <actionName>Skywave_Sourcing_Demand_Forecast</actionName>
            <actionType>stepBackground</actionType>
            <inputParameters>
                <name>inp_Season</name>
                <value>
                    <elementReference>$Record.Season__c</elementReference>
                </value>
            </inputParameters>
        </stageSteps>
        <stageSteps>
            <name>Step_Draft_RFP</name>
            <label>Draft RFP (Prompt Template)</label>
            <actionName>Skywave_Sourcing_Draft_RFP</actionName>
            <actionType>stepBackground</actionType>
            <inputParameters>
                <name>inp_Season</name>
                <value>
                    <elementReference>$Record.Season__c</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>inp_ForecastSummary</name>
                <value>
                    <elementReference>Step_Demand_Forecast.Outputs.out_ForecastSummary</elementReference>
                </value>
            </inputParameters>
        </stageSteps>
    </orchestratedStages>
    <orchestratedStages>
        <name>Stage_2_Issue_RFP</name>
        <label>2. Category Manager Releases RFP</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <connector>
            <targetReference>Stage_3_Evaluate</targetReference>
        </connector>
        <stageSteps>
            <name>Step_Issue_RFP</name>
            <label>Review and Release RFP</label>
            <actionName>Skywave_Sourcing_Issue_RFP</actionName>
            <actionType>stepInteractive</actionType>
            <assignees>
                <assignee>
                    <elementReference>$User.Id</elementReference>
                </assignee>
                <assigneeType>User</assigneeType>
            </assignees>
            <inputParameters>
                <name>ActionInput__RecordId</name>
                <value>
                    <elementReference>$Record.Id</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>inp_Season</name>
                <value>
                    <elementReference>$Record.Season__c</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>inp_RfpDocument</name>
                <value>
                    <elementReference>Step_Draft_RFP.Outputs.out_RfpDocument</elementReference>
                </value>
            </inputParameters>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
        </stageSteps>
    </orchestratedStages>
    <orchestratedStages>
        <name>Stage_3_Evaluate</name>
        <label>3. Evaluate Bids</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <connector>
            <targetReference>Stage_4_Negotiate</targetReference>
        </connector>
        <stageSteps>
            <name>Step_Evaluate_Bids</name>
            <label>Score Supplier Bids</label>
            <actionName>Skywave_Sourcing_Evaluate_Bids</actionName>
            <actionType>stepBackground</actionType>
            <inputParameters>
                <name>inp_Season</name>
                <value>
                    <elementReference>$Record.Season__c</elementReference>
                </value>
            </inputParameters>
        </stageSteps>
    </orchestratedStages>
    <orchestratedStages>
        <name>Stage_4_Negotiate</name>
        <label>4. Negotiate with Leading Supplier (Agent)</label>
        <locationX>176</locationX>
        <locationY>518</locationY>
        <connector>
            <targetReference>Stage_5_Award_And_Contract</targetReference>
        </connector>
        <stageSteps>
            <name>Step_Negotiate</name>
            <label>Agent Negotiation</label>
            <actionName>Skywave_Sourcing_Negotiate_Supplier</actionName>
            <actionType>stepBackground</actionType>
            <inputParameters>
                <name>inp_Season</name>
                <value>
                    <elementReference>$Record.Season__c</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>inp_LeadingSupplier</name>
                <value>
                    <elementReference>Step_Evaluate_Bids.Outputs.out_LeadingSupplier</elementReference>
                </value>
            </inputParameters>
        </stageSteps>
    </orchestratedStages>
    <orchestratedStages>
        <name>Stage_5_Award_And_Contract</name>
        <label>5. Approve Award and Finalize Contract</label>
        <locationX>176</locationX>
        <locationY>638</locationY>
        <stageSteps>
            <name>Step_Award_Approval</name>
            <label>Procurement Director Approval</label>
            <actionName>Skywave_Sourcing_Award_Approval</actionName>
            <actionType>stepInteractive</actionType>
            <assignees>
                <assignee>
                    <elementReference>$User.Id</elementReference>
                </assignee>
                <assigneeType>User</assigneeType>
            </assignees>
            <inputParameters>
                <name>ActionInput__RecordId</name>
                <value>
                    <elementReference>$Record.Id</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>inp_Season</name>
                <value>
                    <elementReference>$Record.Season__c</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>inp_LeadingSupplier</name>
                <value>
                    <elementReference>Step_Evaluate_Bids.Outputs.out_LeadingSupplier</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>inp_NegotiationSummary</name>
                <value>
                    <elementReference>Step_Negotiate.Outputs.out_NegotiationSummary</elementReference>
                </value>
            </inputParameters>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
        </stageSteps>
        <stageSteps>
            <name>Step_Finalize_Contract</name>
            <label>Generate Contract and POs</label>
            <actionName>Skywave_Sourcing_Finalize_Contract</actionName>
            <actionType>stepBackground</actionType>
            <entryConditionLogic>and</entryConditionLogic>
            <entryConditions>
                <leftValueReference>Step_Award_Approval.Outputs.out_ApprovalDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </entryConditions>
            <inputParameters>
                <name>inp_Season</name>
                <value>
                    <elementReference>$Record.Season__c</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>inp_LeadingSupplier</name>
                <value>
                    <elementReference>Step_Evaluate_Bids.Outputs.out_LeadingSupplier</elementReference>
                </value>
            </inputParameters>
        </stageSteps>
    </orchestratedStages>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stage_1_Plan_And_Draft</targetReference>
        </connector>
        <object>Sourcing_Request__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
