<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>STUB (mock): Sourcing pipeline — Step 5 of 7. HANDS OVER TO AN AGENT: invokes the Skywave_Airlines_Agent Agentforce agent (actionType generateAiAgentResponse) to run clarification and negotiation turns with the leading supplier (specifications, unit pricing, rebate tiers) and returns the agent's negotiation summary.</description>
    <environments>Default</environments>
    <interviewLabel>Sourcing Negotiate Supplier {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Skywave Sourcing - Negotiate Supplier (Agent)</label>
    <processType>AutoLaunchedFlow</processType>
    <formulas>
        <name>Negotiation_Prompt</name>
        <dataType>String</dataType>
        <expression>"You are negotiating the seasonal supply contract for Skywave Airlines season " &amp; {!inp_Season} &amp; ". Leading supplier: " &amp; {!inp_LeadingSupplier} &amp; ". Open a negotiation: confirm unit pricing by category, request a 3% volume rebate above 4M units, and lock quality and compliance service levels. Summarize the agreed terms."</expression>
    </formulas>
    <actionCalls>
        <name>Run_Agent_Negotiation</name>
        <label>Run Agent Negotiation</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <actionName>Skywave_Airlines_Agent</actionName>
        <actionType>generateAiAgentResponse</actionType>
        <connector>
            <targetReference>Capture_Agent_Response</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Agent_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <inputParameters>
            <name>userMessage</name>
            <value>
                <elementReference>Negotiation_Prompt</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Skywave_Airlines_Agent</nameSegment>
    </actionCalls>
    <assignments>
        <name>Capture_Agent_Response</name>
        <label>Capture Agent Response</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>out_NegotiationSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Run_Agent_Negotiation.agentResponse</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Capture_Agent_Fault</name>
        <label>Capture Agent Fault (mock fallback)</label>
        <locationX>400</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>out_NegotiationSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>[Mock negotiation summary — agent unavailable in this org] Agreed with {!inp_LeadingSupplier}: unit pricing held flat vs prior season, 3% rebate above 4M units, quality and compliance service levels accepted.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Run_Agent_Negotiation</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>inp_Season</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inp_LeadingSupplier</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>out_NegotiationSummary</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
