<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>STUB (mock): Sourcing pipeline — Step 3 of 7, APPROVAL-SIMULATION. Stands in for the human "Category Manager releases the RFP" interactive step so the orchestration runs green end-to-end for the demo without a work-item assignee. Deterministically returns a "Released" decision plus a note. The real interactive screen flow (Skywave_Sourcing_Issue_RFP) is kept in the repo to swap back in once work-item assignment is sorted.</description>
    <environments>Default</environments>
    <interviewLabel>Sourcing Issue RFP (Sim) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Skywave Sourcing - Issue RFP (Approval Sim)</label>
    <processType>AutoLaunchedFlow</processType>
    <assignments>
        <name>Simulate_Release</name>
        <label>Simulate RFP Release (mock)</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignmentItems>
            <assignToReference>out_ReleaseDecision</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Released</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>out_ReleaseNote</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>[SIMULATED] Category Manager reviewed the draft RFP for the {!inp_Season} season and released it to the supplier panel. (Human review step simulated for the demo.)</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Simulate_Release</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>inp_Season</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inp_RfpDocument</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>out_ReleaseDecision</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>out_ReleaseNote</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
