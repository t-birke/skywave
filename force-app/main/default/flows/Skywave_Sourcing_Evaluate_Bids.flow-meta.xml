        <locationX>176</locationX>
        <locationY>722</locationY>
        <defaultConnector>
            <targetReference>Update_All_Bids</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Bids Evaluated</defaultConnectorLabel>
        <rules>
            <name>No_Bids</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varBidCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
