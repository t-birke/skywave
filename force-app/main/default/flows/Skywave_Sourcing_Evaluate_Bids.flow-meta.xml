        </rules>
    </decisions>
    <decisions>
        <name>Is_Leader_Qualified</name>
        <label>Leader Clears Threshold?</label>
        <locationX>176</locationX>
        <locationY>1010</locationY>
        <defaultConnector>
            <targetReference>Set_No_Qualified_Outputs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Below Threshold</defaultConnectorLabel>
        <rules>
            <name>Qualified</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMaxScore</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>fx_Threshold</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Qualified_Outputs</targetReference>
            </connector>
            <label>Qualified</label>
        </rules>
    </decisions>
