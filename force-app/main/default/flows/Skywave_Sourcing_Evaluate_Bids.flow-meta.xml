    <decisions>
        <name>Was_Request_Found</name>
        <label>Sourcing Request Found?</label>
        <locationX>176</locationX>
        <locationY>218</locationY>
        <defaultConnector>
            <targetReference>Get_Bids</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Found</defaultConnectorLabel>
        <rules>
            <name>Request_Missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Request.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Handle_No_Request</targetReference>
            </connector>
            <label>Not Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_New_Max</name>
        <label>New Highest Score?</label>
        <locationX>440</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Loop_Bids</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Higher</defaultConnectorLabel>
        <rules>
            <name>Is_New_Max</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varThisScore</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>varMaxScore</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Capture_Leader</targetReference>
            </connector>
            <label>Higher Score</label>
        </rules>
    </decisions>
    <decisions>
        <name>Had_Any_Bids</name>
