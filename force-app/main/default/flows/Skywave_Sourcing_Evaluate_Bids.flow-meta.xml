        </connector>
    </assignments>
    <assignments>
        <name>Set_Leader_Continental</name>
        <label>Leader: Continental</label>
        <locationX>270</locationX>
        <locationY>806</locationY>
        <assignmentItems>
            <assignToReference>out_LeadingSupplier</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Continental Sourcing Group</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Build_Shortlist</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Leader_Vantage</name>
        <label>Leader: Vantage</label>
        <locationX>490</locationX>
        <locationY>806</locationY>
        <assignmentItems>
            <assignToReference>out_LeadingSupplier</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Vantage Procurement Partners</stringValue>
            </value>
        </assignmentItems>
        <connector>
