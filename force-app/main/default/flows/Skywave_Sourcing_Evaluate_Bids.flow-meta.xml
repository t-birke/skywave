<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>STUB (mock): Sourcing pipeline — Step 4 of 7. Background step that scores the bids returned by the supplier panel on a weighted matrix (price 40%, quality 25%, sustainability 20%, service level 15%) and returns the leading supplier, its score, and the shortlist. Deterministic mock output (max score 87.4 -> Meridian). Deliberately built out with many elements — Get Records + fault path, a not-found branch, a Loop that tracks the maximum score, a four-way "which supplier leads" decision, and an Update Records with its own fault path — so it can be used to walk an audience through the Flow Builder canvas.</description>
    <environments>Default</environments>
    <interviewLabel>Sourcing Evaluate Bids {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Skywave Sourcing - Evaluate Bids</label>
    <processType>AutoLaunchedFlow</processType>
    <assignments>
        <name>Init_Evaluation</name>
        <label>Initialize Counters</label>
        <locationX>176</locationX>
        <locationY>326</locationY>
        <assignmentItems>
            <assignToReference>varMaxScore</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varBidCount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Seed_Bid_Scores</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Seed_Bid_Scores</name>
        <label>Seed Bid Scores (mock)</label>
        <locationX>176</locationX>
        <locationY>446</locationY>
        <assignmentItems>
            <assignToReference>collBidScores</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>87.4</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>collBidScores</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>84.1</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>collBidScores</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>79.6</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>collBidScores</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>62.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Bid_Scores</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Capture_New_Max</name>
        <label>Capture New Max</label>
        <locationX>578</locationX>
        <locationY>434</locationY>
        <assignmentItems>
            <assignToReference>varMaxScore</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Bid_Scores</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varBidCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Bid_Scores</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Bid_Only</name>
        <label>Count Bid Only</label>
        <locationX>810</locationX>
        <locationY>434</locationY>
        <assignmentItems>
            <assignToReference>varBidCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Bid_Scores</targetReference>
        </connector>
    </assignments>
    <assignments>
