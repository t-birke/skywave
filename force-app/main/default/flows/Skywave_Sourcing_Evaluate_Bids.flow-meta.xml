<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>Sourcing pipeline — Step 4 of 7. Evaluates the supplier bids submitted against a sourcing request. Reads every Supplier_Bid__c for the request, computes each bid's weighted total from its own component scores (price / quality / sustainability / service level) against the request's configurable weights, ranks them, flags the single highest bid that clears the request's qualifying threshold, and writes the weighted totals and leader flag back to the bids. Fully data-driven — no supplier names, scores, or weights are hardcoded. Returns the leading supplier, its weighted score, and a shortlist for the orchestration.</description>
    <environments>Default</environments>
    <interviewLabel>Sourcing Evaluate Bids {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Skywave Sourcing - Evaluate Bids</label>
    <processType>AutoLaunchedFlow</processType>
    <formulas>
        <name>fx_WeightedTotal</name>
        <dataType>Number</dataType>
        <scale>1</scale>
        <expression>ROUND(
(
  BLANKVALUE({!Loop_Bids.Price_Score__c},0) * BLANKVALUE({!Get_Request.Weight_Price__c},40)
+ BLANKVALUE({!Loop_Bids.Quality_Score__c},0) * BLANKVALUE({!Get_Request.Weight_Quality__c},25)
+ BLANKVALUE({!Loop_Bids.Sustainability_Score__c},0) * BLANKVALUE({!Get_Request.Weight_Sustainability__c},20)
+ BLANKVALUE({!Loop_Bids.Service_Level_Score__c},0) * BLANKVALUE({!Get_Request.Weight_Service_Level__c},15)
) / (
  BLANKVALUE({!Get_Request.Weight_Price__c},40)
+ BLANKVALUE({!Get_Request.Weight_Quality__c},25)
+ BLANKVALUE({!Get_Request.Weight_Sustainability__c},20)
+ BLANKVALUE({!Get_Request.Weight_Service_Level__c},15)
), 1)</expression>
    </formulas>
    <formulas>
        <name>fx_Threshold</name>
        <dataType>Number</dataType>
        <scale>1</scale>
        <expression>BLANKVALUE({!Get_Request.Qualifying_Threshold__c}, 75)</expression>
    </formulas>
    <formulas>
        <name>fx_AppendShortlist</name>
        <dataType>String</dataType>
        <expression>{!out_Shortlist} &amp; {!Loop_Bids.Supplier_Name__c} &amp; " (" &amp; TEXT({!fx_WeightedTotal}) &amp; "). "</expression>
    </formulas>
