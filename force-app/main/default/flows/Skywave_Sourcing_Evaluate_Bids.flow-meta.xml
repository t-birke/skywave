        </connector>
    </assignments>
    <assignments>
        <name>Set_Leader_None</name>
        <label>Leader: None Qualified</label>
        <locationX>710</locationX>
        <locationY>806</locationY>
        <assignmentItems>
            <assignToReference>out_LeadingSupplier</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No qualified supplier</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Build_Shortlist</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_Shortlist</name>
        <label>Build Shortlist and Outputs</label>
        <locationX>380</locationX>
        <locationY>926</locationY>
        <assignmentItems>
            <assignToReference>out_LeadingScore</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varMaxScore</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>out_Shortlist</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>1. Meridian Supply Partners Ltd. (87.4) — best price/sustainability blend. 2. Continental Sourcing Group (84.1) — strongest quality record. 3. Vantage Procurement Partners (79.6) — lowest unit price but weaker service-level history.</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Request_Status</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Finalize_Success</name>
        <label>Finalize (success)</label>
        <locationX>380</locationX>
        <locationY>1166</locationY>
        <assignmentItems>
            <assignToReference>varRunNote</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Evaluation complete: scored {!varBidCount} bids; leading supplier recorded and request status advanced.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Handle_No_Request</name>
        <label>Handle Missing Request</label>
        <locationX>726</locationX>
        <locationY>206</locationY>
        <assignmentItems>
            <assignToReference>out_LeadingSupplier</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No sourcing request found</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>out_LeadingScore</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>out_Shortlist</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No matching Sourcing_Request__c for the supplied season — evaluation skipped.</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varRunNote</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Missing request — safe defaults returned.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Handle_Query_Fault</name>
        <label>Handle Query Fault</label>
        <locationX>726</locationX>
        <locationY>50</locationY>
        <assignmentItems>
            <assignToReference>out_LeadingSupplier</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Bid evaluation unavailable</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>out_LeadingScore</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>out_Shortlist</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Could not query sourcing requests ({!$Flow.FaultMessage}).</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varRunNote</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Query fault handled — safe defaults returned.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Handle_Update_Fault</name>
        <label>Handle Update Fault</label>
        <locationX>726</locationX>
        <locationY>1046</locationY>
        <assignmentItems>
            <assignToReference>varRunNote</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Scores computed but status update failed ({!$Flow.FaultMessage}); outputs still returned.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Was_Request_Found</name>
        <label>Sourcing Request Found?</label>
        <locationX>176</locationX>
        <locationY>206</locationY>
        <defaultConnector>
            <targetReference>Init_Evaluation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Found</defaultConnectorLabel>
        <rules>
            <name>Request_Missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sourcing_Request.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Handle_No_Request</targetReference>
            </connector>
            <label>Not Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_New_Max</name>
        <label>New Maximum Score?</label>
        <locationX>380</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Count_Bid_Only</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Higher</defaultConnectorLabel>
        <rules>
            <name>Is_New_Max</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Bid_Scores</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>varMaxScore</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Capture_New_Max</targetReference>
            </connector>
            <label>Higher Score</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Leader</name>
        <label>Which Supplier Leads?</label>
        <locationX>380</locationX>
        <locationY>686</locationY>
        <defaultConnector>
            <targetReference>Set_Leader_None</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None Qualified</defaultConnectorLabel>
        <rules>
            <name>Leader_Meridian</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMaxScore</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>87.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Leader_Meridian</targetReference>
            </connector>
            <label>Meridian (>= 87)</label>
        </rules>
        <rules>
            <name>Leader_Continental</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMaxScore</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>84.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Leader_Continental</targetReference>
            </connector>
            <label>Continental (>= 84)</label>
        </rules>
        <rules>
            <name>Leader_Vantage</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMaxScore</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>79.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Leader_Vantage</targetReference>
            </connector>
            <label>Vantage (>= 79)</label>
        </rules>
    </decisions>
    <loops>
        <name>Loop_Bid_Scores</name>
        <label>Loop Bid Scores</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <collectionReference>collBidScores</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_New_Max</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Determine_Leader</targetReference>
        </noMoreValuesConnector>
    </loops>
    <recordLookups>
        <name>Get_Sourcing_Request</name>
        <label>Get Sourcing Request</label>
        <locationX>176</locationX>
        <locationY>86</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Was_Request_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Handle_Query_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Season__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inp_Season</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Sourcing_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Request_Status</name>
        <label>Update Request Status</label>
        <locationX>380</locationX>
        <locationY>1046</locationY>
        <connector>
            <targetReference>Finalize_Success</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Handle_Update_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Season__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inp_Season</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>In Sourcing</stringValue>
            </value>
        </inputAssignments>
        <object>Sourcing_Request__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Sourcing_Request</targetReference>
        </connector>
    </start>
