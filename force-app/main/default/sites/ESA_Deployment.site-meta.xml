<?xml version="1.0" encoding="UTF-8" ?>
<CustomSite xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowGuestPaymentsApi>false</allowGuestPaymentsApi>
    <allowHomePage>false</allowHomePage>
    <allowStandardAnswersPages>false</allowStandardAnswersPages>
    <allowStandardIdeasPages>false</allowStandardIdeasPages>
    <allowStandardLookups>false</allowStandardLookups>
    <allowStandardPortalPages>true</allowStandardPortalPages>
    <allowStandardSearch>false</allowStandardSearch>
    <authorizationRequiredPage>CommunitiesLogin</authorizationRequiredPage>
    <bandwidthExceededPage>BandwidthExceeded</bandwidthExceededPage>
    <browserXssProtection>true</browserXssProtection>
    <cachePublicVisualforcePagesInProxyServers
    >true</cachePublicVisualforcePagesInProxyServers>
    <clickjackProtectionLevel>SameOriginOnly</clickjackProtectionLevel>
    <contentSniffingProtection>true</contentSniffingProtection>
    <enableAuraRequests>true</enableAuraRequests>
    <fileNotFoundPage>FileNotFound</fileNotFoundPage>
    <genericErrorPage>Exception</genericErrorPage>
    <inMaintenancePage>InMaintenance</inMaintenancePage>
    <indexPage>CommunitiesLanding</indexPage>
    <masterLabel>ESA_Deployment</masterLabel>
    <redirectToCustomDomain>false</redirectToCustomDomain>
    <referrerPolicyOriginWhenCrossOrigin
    >true</referrerPolicyOriginWhenCrossOrigin>
    <selfRegPage>CommunitiesSelfReg</selfRegPage>
    <serverIsDown>SNA_HUpnp_sf_default_cdn_ESA_Deployment1</serverIsDown>
    <siteIframeWhiteListUrls>
        <url>my.site.com</url>
    </siteIframeWhiteListUrls>
    <siteIframeWhiteListUrls>
        <url>*.my.site.com</url>
    </siteIframeWhiteListUrls>
    <siteIframeWhiteListUrls>
        <url>my.pc-rnd.site.com</url>
    </siteIframeWhiteListUrls>
    <siteIframeWhiteListUrls>
        <url>*.my.pc-rnd.site.com</url>
    </siteIframeWhiteListUrls>
    <siteIframeWhiteListUrls>
        <url>*.vf.force.com</url>
    </siteIframeWhiteListUrls>
    <!-- Per-scratch-org host entries populated by sfdx-project.json replaceWithEnv at deploy
         time. Required on pc-rnd: the widget's iframe's parent postMessage handshake only
         works when the exact scratch host AND its subdomain wildcard are listed. Without
         the wildcard, the wizard-created ESW site renders the button and a vendored
         ChatterNetwork site does not (the auto-computed CSP frame-ancestors diverges). -->
    <siteIframeWhiteListUrls>
        <url>%%SCRATCH_ORG_SITE_HOST%%</url>
    </siteIframeWhiteListUrls>
    <siteIframeWhiteListUrls>
        <url>*.%%SCRATCH_ORG_SITE_HOST%%</url>
    </siteIframeWhiteListUrls>
    <siteIframeWhiteListUrls>
        <url>%%SCRATCH_ORG_VF_HOST%%</url>
    </siteIframeWhiteListUrls>
    <!-- The Skywave consumer site is hosted on Heroku, not on a Salesforce
         site host. Without this entry the chat iframe load is blocked by the
         LWR CSP `frame-ancestors` directive on the embedding page. The
         herokuapp.com wildcard covers any provisioned dyno (and survives app
         renames), so no per-install host substitution is needed. -->
    <siteIframeWhiteListUrls>
        <url>*.herokuapp.com</url>
    </siteIframeWhiteListUrls>
    <!-- Custom-domain cutover: the consumer site also serves on
         app.skywave.flights, which shares the registrable domain skywave.flights
         with the chat site chat.skywave.flights — so the guest cookie is
         first-party and the iOS redirect loop is gone. The chat iframe's parent
         is app.skywave.flights, so its host must be in frame-ancestors here.
         Both the exact host and the wildcard are listed (the parent postMessage
         handshake wants the exact host, per the pc-rnd note above). -->
    <siteIframeWhiteListUrls>
        <url>app.skywave.flights</url>
    </siteIframeWhiteListUrls>
    <siteIframeWhiteListUrls>
        <url>*.skywave.flights</url>
    </siteIframeWhiteListUrls>
    <siteType>ChatterNetwork</siteType>
    <urlPathPrefix>ESADeploymentvforce</urlPathPrefix>
</CustomSite>
