<!-- ── MOBILE VIEW TOGGLE JS ── -->
<script type="text/javascript">
//<![CDATA[
(function() {
  var viewToggleBtn = document.getElementById('viewToggleBtn');
  var hamburgerBtn  = document.getElementById('hamburgerBtn');
  var mobileNavDrawer = document.getElementById('mobileNavDrawer');
  var forceViewMode = null;

  function setView(mobile) {
    document.body.classList.toggle('mobile-view', mobile);
    viewToggleBtn.title = mobile ? 'Switch to desktop view' : 'Switch to mobile view';
    if (!mobile) mobileNavDrawer.classList.remove('open');
  }

  function autoDetect() {
    if (forceViewMode === null) setView(window.innerWidth < 769);
  }

  viewToggleBtn.addEventListener('click', function() {
    var isMobile = document.body.classList.contains('mobile-view');
    forceViewMode = isMobile ? 'desktop' : 'mobile';
    setView(!isMobile);
  });

  hamburgerBtn.addEventListener('click', function() {
    mobileNavDrawer.classList.toggle('open');
  });

  window.addEventListener('resize', function() {
    var w = window.innerWidth;
    if (forceViewMode === 'desktop') { if (w < 481) forceViewMode = null; }
    autoDetect();
  });

  autoDetect();
})();
//]]>
</script>

<!-- ── PHONE CALL UI JS ── -->
<script type="text/javascript">
//<![CDATA[
(function() {
  var callFab   = document.getElementById('mobCallFab');
  var callUI    = document.getElementById('iphoneCallUI');
  var statusTxt = document.getElementById('callStatusTxt');
  var endBtn    = document.getElementById('callEndBtn');
  var callTimer = null;
  var callSecs  = 0;

  function fmtTime(t) {
    var m  = Math.floor(t / 60);
    var s  = t % 60;
    var ss = String(s);
    return m + ':' + (ss.length === 1 ? '0' + ss : ss);
  }

  function openCallUI() {
    if (!document.body.classList.contains('mobile-view')) return;
    callUI.classList.add('call-active');
    statusTxt.textContent = 'calling...';
    callSecs = 0;
    setTimeout(function() {
      statusTxt.textContent = fmtTime(0);
      callTimer = setInterval(function() {
        callSecs = callSecs + 1;
        statusTxt.textContent = fmtTime(callSecs);
      }, 1000);
    }, 2200);
  }

  function closeCallUI() {
    callUI.classList.remove('call-active');
    if (callTimer) { clearInterval(callTimer); callTimer = null; }
    callSecs = 0;
    statusTxt.textContent = 'calling...';
    document.querySelectorAll('.c-btn.on').forEach(function(b) { b.classList.remove('on'); });
  }

  window.callCtrlToggle = function(ctrl) {
    var cap = ctrl.charAt(0).toUpperCase() + ctrl.slice(1);
    var el  = document.getElementById('cBtn' + cap);
    if (el) el.classList.toggle('on');
  };

  window.callRealPhone = function() {
    var btn = document.getElementById('cBtnAudio');
    if (btn) btn.classList.add('on');
    window.location.href = 'tel:+16466533908';
  };

  if (callFab) callFab.addEventListener('click', openCallUI);
  if (endBtn)  endBtn.addEventListener('click', closeCallUI);

  function updateClock() {
    var el = document.getElementById('phoneClock');
    if (!el) return;
    var d  = new Date();
    var h  = d.getHours();
    var m  = d.getMinutes();
    var ms = String(m);
    el.textContent = h + ':' + (ms.length === 1 ? '0' + ms : ms);
  }
  updateClock();
  setInterval(updateClock, 30000);
})();
//]]>
</script>

