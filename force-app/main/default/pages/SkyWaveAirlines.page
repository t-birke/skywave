<apex:page showHeader="false" standardStylesheets="false" docType="html-5.0" title="SkyWave Airlines">
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>SkyWave Airlines</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
<style>
/* ── RESET ── */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

/* ── TOKENS ── */
:root {
  --navy:       #0D1B2A;
  --navy-mid:   #132030;
  --navy-deep:  #091422;
  --teal:       #00C9A7;
  --teal-hover: #00B594;
  --white:      #FFFFFF;
  --muted:      rgba(255,255,255,0.55);
  --sub:        rgba(255,255,255,0.80);
  --border:     #E4E8EF;
  --input-bg:   #F7F9FC;
  --card-shadow: 0 4px 24px rgba(0,0,0,0.07);
  --r-sm:  10px;
  --r-md:  16px;
  --r-lg:  24px;
  --r-pill: 100px;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background: var(--navy);
  color: var(--white);
  -webkit-font-smoothing: antialiased;
  line-height: 1.5;
}

/* ── NAV ── */
.nav {
  position: sticky; top: 0; z-index: 100;
  background: rgba(9,20,34,0.92);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  height: 68px;
  padding: 0 48px;
  display: flex; align-items: center; justify-content: space-between;
}
.nav-logo {
  display: flex; align-items: center; gap: 10px; cursor: pointer; text-decoration: none;
}
.logo-mark {
  width: 38px; height: 38px;
  background: var(--teal);
  border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.logo-mark svg { width: 22px; height: 22px; }
.logo-text { font-size: 18px; font-weight: 800; letter-spacing: -0.4px; color: var(--white); }
.logo-text span { color: var(--teal); }

.nav-links {
  display: flex; gap: 32px;
}
.nav-links a {
  font-size: 14px; font-weight: 500;
  color: var(--muted); text-decoration: none; cursor: pointer;
  transition: color .2s;
}
.nav-links a:hover { color: var(--white); }
.nav-links a.active { color: var(--teal); }

.nav-right { display: flex; align-items: center; gap: 14px; }
.pts-chip {
  display: flex; align-items: center; gap: 7px;
  background: rgba(0,201,167,0.10);
  border: 1px solid rgba(0,201,167,0.22);
  padding: 6px 14px; border-radius: var(--r-pill);
  font-size: 13px; font-weight: 600; color: var(--teal);
}
.pts-chip svg { width: 13px; height: 13px; }
.nav-user { font-size: 14px; color: var(--sub); }
.nav-btn {
  font-size: 13px; font-weight: 600;
  background: var(--teal); color: var(--navy);
  border: none; padding: 8px 20px; border-radius: var(--r-pill);
  cursor: pointer; transition: background .2s;
}
.nav-btn:hover { background: var(--teal-hover); }

/* ── VIEW TOGGLE + HAMBURGER BUTTONS ── */
.view-toggle-btn {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  color: var(--white); width: 36px; height: 36px;
  border-radius: var(--r-sm); cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background .2s; flex-shrink: 0;
}
.view-toggle-btn:hover { background: rgba(255,255,255,0.16); }
.view-toggle-btn svg { width: 17px; height: 17px; }
.vt-icon-mobile { display: block; }
.vt-icon-desktop { display: none; }

.hamburger-btn {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  color: var(--white); width: 36px; height: 36px;
  border-radius: var(--r-sm); cursor: pointer;
  display: none; align-items: center; justify-content: center;
  transition: background .2s; flex-shrink: 0;
}
.hamburger-btn:hover { background: rgba(255,255,255,0.16); }
.hamburger-btn svg { width: 20px; height: 20px; }

/* ── MOBILE NAV DRAWER ── */
.mobile-nav-drawer {
  background: var(--navy-mid);
  border-top: 1px solid rgba(255,255,255,0.07);
  position: sticky; top: 68px; z-index: 99;
  overflow: hidden; max-height: 0; transition: max-height .3s ease;
  box-shadow: 0 6px 24px rgba(0,0,0,0.3);
}
.mobile-nav-drawer.open { max-height: 400px; }
.mob-drawer-inner { padding: 8px 20px 20px; }
.mob-nav-links { display: flex; flex-direction: column; }
.mob-nav-links a {
  color: var(--sub); text-decoration: none; font-size: 16px; font-weight: 500;
  padding: 11px 0; border-bottom: 1px solid rgba(255,255,255,0.06);
  cursor: pointer; transition: color .15s, padding-left .15s; display: block;
}
.mob-nav-links a:last-child { border-bottom: none; }
.mob-nav-links a:hover { color: var(--teal); padding-left: 6px; }
.mob-nav-links a.active { color: var(--teal); }
.mob-drawer-footer {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 12px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.07);
}
.mob-pts-chip {
  display: flex; align-items: center; gap: 6px;
  background: rgba(0,201,167,0.10); border: 1px solid rgba(0,201,167,0.22);
  padding: 5px 12px; border-radius: var(--r-pill);
  font-size: 12px; font-weight: 600; color: var(--teal);
}
.mob-user-links { display: flex; gap: 14px; }
.mob-user-links a { color: var(--muted); font-size: 13px; text-decoration: none; cursor: pointer; }
.mob-user-links a:hover { color: var(--white); }

/* ── HERO ── */
.hero {
  background: var(--navy);
  min-height: calc(100vh - 68px);
  padding: 80px 48px 100px;
  position: relative; overflow: hidden;
  display: flex; align-items: center;
}
/* dot-grid world-map texture */
.hero-dots {
  position: absolute; inset: 0; z-index: 0;
  background-image: radial-gradient(circle, rgba(0,201,167,0.18) 1px, transparent 1px);
  background-size: 30px 30px;
  -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
}
/* ambient glow */
.hero-glow {
  position: absolute; z-index: 0;
  width: 700px; height: 700px;
  background: radial-gradient(circle, rgba(0,201,167,0.07) 0%, transparent 70%);
  top: -200px; right: -100px; pointer-events: none;
}
.hero-content {
  position: relative; z-index: 2;
  max-width: 1200px; margin: 0 auto; width: 100%;
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 80px; align-items: center;
}
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(0,201,167,0.08);
  border: 1px solid rgba(0,201,167,0.20);
  padding: 6px 14px; border-radius: var(--r-pill);
  font-size: 11px; font-weight: 700; letter-spacing: 0.8px;
  text-transform: uppercase; color: var(--teal);
  margin-bottom: 24px;
}
.hero-title {
  font-size: clamp(40px, 4.5vw, 62px);
  font-weight: 900; line-height: 1.08;
  letter-spacing: -2px; margin-bottom: 20px;
}
.hero-title .accent { color: var(--teal); }
.hero-sub {
  font-size: 16px; color: var(--muted); line-height: 1.75;
  max-width: 400px; margin-bottom: 44px;
}
.hero-stats { display: flex; gap: 40px; }
.stat-num { font-size: 26px; font-weight: 900; color: var(--white); }
.stat-label { font-size: 12px; color: var(--muted); margin-top: 3px; }

/* big plane SVG behind left col */
.hero-plane {
  position: absolute; z-index: 1;
  right: 46%; bottom: -20px;
  width: 340px; opacity: 0.06;
  pointer-events: none;
}

/* ── SEARCH CARD ── */
.search-card {
  background: var(--white);
  border-radius: var(--r-lg);
  padding: 28px;
  box-shadow: 0 28px 80px rgba(0,0,0,0.35);
  color: #1a1a2e;
}
.s-tabs {
  display: flex; gap: 4px;
  background: #EEF1F5;
  border-radius: var(--r-pill);
  padding: 4px; margin-bottom: 22px;
}
.s-tab {
  flex: 1; text-align: center;
  padding: 9px 16px; border-radius: var(--r-pill);
  font-size: 13px; font-weight: 600; color: #888;
  cursor: pointer; transition: all .2s;
  display: flex; align-items: center; justify-content: center; gap: 6px;
}
.s-tab.active {
  background: var(--white);
  color: var(--navy);
  box-shadow: 0 2px 8px rgba(0,0,0,0.10);
}
.s-tab.active .tab-pip { background: var(--teal); }
.tab-pip { width: 7px; height: 7px; border-radius: 50%; background: #ccc; flex-shrink: 0; }

.s-fields { display: flex; flex-direction: column; gap: 10px; }
.s-field {
  display: flex; align-items: center; gap: 12px;
  border: 1.5px solid var(--border);
  border-radius: var(--r-sm);
  padding: 13px 16px;
  background: var(--input-bg);
  transition: border-color .2s, background .2s;
}
.s-field:focus-within { border-color: var(--teal); background: var(--white); }
.s-field svg { width: 17px; height: 17px; color: #aaa; flex-shrink: 0; }
.s-field input,
.s-field select {
  flex: 1; border: none; background: transparent;
  font-size: 14px; font-weight: 500; color: #1a1a2e;
  outline: none; font-family: inherit;
}
.s-field input::placeholder { color: #bbb; font-weight: 400; }
.s-field select { cursor: pointer; }
.s-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.btn-search {
  width: 100%; padding: 15px;
  background: var(--teal); color: var(--white);
  border: none; border-radius: var(--r-pill);
  font-size: 15px; font-weight: 700; cursor: pointer;
  margin-top: 14px; letter-spacing: 0.2px;
  transition: background .2s, transform .15s;
  font-family: inherit;
}
.btn-search:hover { background: var(--teal-hover); transform: translateY(-1px); }

/* ── MAIN CONTENT (light bg) ── */
.main {
  background: #F2F5F9;
  color: #1a1a2e;
  padding-bottom: 60px;
}

/* ── TICKET STRIP ── */
.ticket-strip {
  max-width: 1200px; margin: 0 auto;
  padding: 44px 48px 0;
}
.ticket-card {
  background: var(--navy);
  border-radius: var(--r-md);
  padding: 26px 32px;
  display: flex; align-items: center; justify-content: space-between; gap: 24px;
  border: 1px solid rgba(255,255,255,0.05);
}
.ticket-eyebrow {
  font-size: 11px; font-weight: 700; text-transform: uppercase;
  letter-spacing: 1px; color: var(--teal); margin-bottom: 10px;
}
.ticket-route {
  display: flex; align-items: center; gap: 18px; margin-bottom: 8px;
}
.t-code { font-size: 34px; font-weight: 900; color: var(--white); }
.t-line-wrap {
  flex: 1; max-width: 120px;
  display: flex; flex-direction: column; align-items: center; gap: 4px;
}
.t-line {
  width: 100%; height: 1px; background: rgba(255,255,255,0.15); position: relative;
}
.t-line::before {
  content: ''; position: absolute; left: -4px; top: -4px;
  width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.25);
}
.t-line::after {
  content: ''; position: absolute; right: -4px; top: -4px;
  width: 8px; height: 8px; border-radius: 50%; background: var(--teal);
}
.t-dur { font-size: 11px; color: var(--muted); }
.ticket-meta { font-size: 13px; color: var(--muted); line-height: 1.6; }
.ticket-meta strong { color: var(--white); }
.ticket-links { display: flex; gap: 16px; margin-top: 12px; flex-wrap: wrap; }
.ticket-links a {
  font-size: 12px; font-weight: 600; color: var(--teal);
  text-decoration: none; cursor: pointer;
}
.ticket-links a:hover { text-decoration: underline; }
.btn-manage {
  background: var(--teal); color: var(--navy);
  border: none; padding: 11px 24px; border-radius: var(--r-pill);
  font-size: 13px; font-weight: 700; cursor: pointer; white-space: nowrap;
  transition: background .2s; font-family: inherit;
}
.btn-manage:hover { background: var(--teal-hover); }

/* ── DEALS ── */
.section {
  max-width: 1200px; margin: 0 auto;
  padding: 48px 48px 0;
}
.section-head {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px;
}
.section-title { font-size: 20px; font-weight: 800; color: var(--navy); }
.section-more {
  font-size: 13px; font-weight: 600; color: var(--teal);
  text-decoration: none; cursor: pointer; display: flex; align-items: center; gap: 4px;
}
.section-more:hover { text-decoration: underline; }
.deals-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.deal-card {
  background: var(--white); border-radius: var(--r-md);
  overflow: hidden; cursor: pointer;
  box-shadow: var(--card-shadow);
  border: 1px solid rgba(0,0,0,0.04);
  transition: transform .2s, box-shadow .2s;
}
.deal-card:hover { transform: translateY(-4px); box-shadow: 0 14px 40px rgba(0,0,0,0.11); }
.deal-img {
  height: 140px; display: flex; align-items: center;
  justify-content: center; font-size: 54px;
}
.deal-img.c1 { background: linear-gradient(135deg, #0D1B2A 0%, #1e3a52 100%); }
.deal-img.c2 { background: linear-gradient(135deg, #003D35 0%, #00695C 100%); }
.deal-img.c3 { background: linear-gradient(135deg, #1a0533 0%, #4a1278 100%); }
.deal-body { padding: 18px 20px; }
.deal-tag {
  display: inline-block;
  background: rgba(0,201,167,0.10); color: var(--teal);
  font-size: 10px; font-weight: 700; padding: 3px 10px;
  border-radius: var(--r-pill); margin-bottom: 8px;
  text-transform: uppercase; letter-spacing: 0.5px;
}
.deal-body h4 { font-size: 15px; font-weight: 800; color: var(--navy); margin-bottom: 5px; }
.deal-body p  { font-size: 13px; color: #777; line-height: 1.55; }

/* ── POINTS BANNER ── */
.pts-banner { max-width: 1200px; margin: 0 auto; padding: 32px 48px; }
.pts-inner {
  background: var(--navy);
  border-radius: var(--r-lg);
  padding: 44px 48px;
  display: flex; align-items: center; justify-content: space-between; gap: 40px;
  position: relative; overflow: hidden;
  border: 1px solid rgba(255,255,255,0.05);
}
.pts-inner::before {
  content: '';
  position: absolute; top: -100px; right: -80px;
  width: 360px; height: 360px;
  background: radial-gradient(circle, rgba(0,201,167,0.12), transparent 70%);
  pointer-events: none;
}
.pts-inner h3 { font-size: 26px; font-weight: 900; margin-bottom: 10px; position: relative; }
.pts-inner p  { font-size: 14px; color: var(--muted); max-width: 460px; line-height: 1.75; position: relative; }
.btn-pts {
  background: var(--teal); color: var(--navy);
  border: none; padding: 14px 32px; border-radius: var(--r-pill);
  font-size: 14px; font-weight: 700; cursor: pointer; white-space: nowrap;
  transition: background .2s; position: relative; font-family: inherit;
}
.btn-pts:hover { background: var(--teal-hover); }

/* ── FOOTER ── */
footer {
  background: var(--navy-deep);
  padding: 64px 48px 40px;
  color: var(--muted); font-size: 13px;
}
.footer-inner {
  max-width: 1200px; margin: 0 auto;
  display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px;
  padding-bottom: 44px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  margin-bottom: 32px;
}
.footer-brand p { max-width: 260px; line-height: 1.75; margin-top: 14px; }
footer h5 { color: var(--white); font-size: 13px; font-weight: 700; margin-bottom: 16px; }
footer a { display: block; color: var(--muted); text-decoration: none; margin-bottom: 10px; cursor: pointer; transition: color .2s; }
footer a:hover { color: var(--white); }
.footer-bottom {
  max-width: 1200px; margin: 0 auto;
  display: flex; align-items: center; justify-content: space-between; font-size: 12px;
}

/* ── CHAT BUTTON ── */
.chat-btn {
  position: fixed; bottom: calc(28px + env(safe-area-inset-bottom, 0px)); right: 28px;
  background: var(--teal); color: var(--navy);
  border: none; padding: 14px 22px; border-radius: var(--r-pill);
  font-size: 14px; font-weight: 700; cursor: pointer;
  box-shadow: 0 8px 32px rgba(0,201,167,0.40);
  display: flex; align-items: center; gap: 10px;
  transition: transform .2s, box-shadow .2s; z-index: 999;
  font-family: inherit;
}
.chat-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(0,201,167,0.50); }
.chat-btn svg { width: 18px; height: 18px; }
.chat-pulse {
  width: 8px; height: 8px; background: var(--navy);
  border-radius: 50%; animation: pulse 2s infinite;
}
@keyframes pulse {
  0%,100% { opacity:0.5; transform:scale(1); }
  50%      { opacity:1;   transform:scale(1.35); }
}

/* ── CHAT WINDOW ── */
.chat-window {
  position: fixed; bottom: calc(90px + env(safe-area-inset-bottom, 0px)); right: 28px;
  width: 380px; height: min(560px, calc(100dvh - 140px));
  background: #F2F5F9; border-radius: var(--r-lg);
  box-shadow: 0 24px 80px rgba(0,0,0,0.28);
  display: flex; flex-direction: column;
  z-index: 1000; overflow: hidden;
  transition: transform .3s cubic-bezier(.34,1.56,.64,1), opacity .3s;
  transform-origin: bottom right;
}
.chat-window.hidden { transform: scale(0.7); opacity: 0; pointer-events: none; }
.chat-header {
  background: var(--navy);
  padding: 16px 20px; color: var(--white);
  display: flex; align-items: center; gap: 12px;
}
.chat-avatar {
  width: 38px; height: 38px; background: var(--teal);
  border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; flex-shrink: 0;
}
.chat-hinfo { flex: 1; }
.chat-hinfo h4 { font-size: 14px; font-weight: 700; }
.chat-hinfo p  { font-size: 11px; opacity: 0.65; display: flex; align-items: center; gap: 5px; margin-top: 2px; }
.s-dot { width: 6px; height: 6px; background: var(--teal); border-radius: 50%; display: inline-block; }
.chat-close {
  background: rgba(255,255,255,0.10); border: none; color: var(--white);
  width: 28px; height: 28px; border-radius: 50%; cursor: pointer;
  font-size: 14px; display: flex; align-items: center; justify-content: center;
}
.chat-close:hover { background: rgba(255,255,255,0.20); }
.chat-msgs {
  flex: 1; overflow-y: auto; padding: 18px 14px;
  display: flex; flex-direction: column; gap: 14px; scroll-behavior: smooth;
}
.chat-msgs::-webkit-scrollbar { width: 4px; }
.chat-msgs::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
.msg { display: flex; gap: 8px; align-items: flex-end; }
.msg.user { flex-direction: row-reverse; }
.msg-av {
  width: 28px; height: 28px; border-radius: var(--r-sm); flex-shrink: 0;
  background: var(--navy);
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; color: var(--teal);
}
.msg-bub {
  max-width: 80%; padding: 11px 14px; border-radius: 16px;
  font-size: 13px; line-height: 1.5;
}
.msg.agent .msg-bub { background: var(--white); color: #1a1a2e; border-bottom-left-radius: 4px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
.msg.user  .msg-bub { background: var(--teal); color: var(--navy); border-bottom-right-radius: 4px; font-weight: 500; }
.msg-bub ul { padding-left: 16px; margin: 6px 0; }
.msg-bub li { margin-bottom: 4px; }
.msg-bub strong { font-weight: 700; }
.typing-ind {
  display: flex; gap: 4px; padding: 12px 14px;
  background: var(--white); border-radius: 16px; border-bottom-left-radius: 4px;
  width: fit-content; align-items: center; box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}
.t-dot { width: 7px; height: 7px; background: #bbb; border-radius: 50%; animation: bounce 1.2s infinite; }
.t-dot:nth-child(2) { animation-delay: .2s; }
.t-dot:nth-child(3) { animation-delay: .4s; }
@keyframes bounce {
  0%,80%,100% { transform:translateY(0);   opacity:.4; }
  40%          { transform:translateY(-5px); opacity:1; }
}
.flight-opts { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
.f-card {
  background: var(--white); border: 1.5px solid #E4E8EF; border-radius: 12px;
  padding: 12px 14px; cursor: pointer; transition: all .2s;
}
.f-card:hover   { border-color: var(--teal); }
.f-card.selected{ border-color: var(--teal); background: rgba(0,201,167,0.05); }
.f-card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.f-num   { font-size: 10px; font-weight: 700; color: #999; text-transform: uppercase; letter-spacing: .5px; }
.f-price { font-size: 15px; font-weight: 800; color: var(--teal); }
.f-price span { font-size: 10px; font-weight: 500; color: #999; }
.f-times { display: flex; align-items: center; gap: 8px; }
.f-dep, .f-arr { font-size: 16px; font-weight: 800; color: var(--navy); }
.f-sep { flex:1; display:flex; flex-direction:column; align-items:center; gap:2px; }
.f-line { width:100%; height:1px; background:#E0E0E0; position:relative; }
.f-line::after { content:'✈'; position:absolute; right:-4px; top:-8px; font-size:11px; color:var(--teal); }
.f-dur   { font-size:10px; color:#999; }
.f-ns    { font-size:10px; color:#22c55e; font-weight:600; }
.date-pills { display:flex; gap:5px; margin-bottom:10px; flex-wrap:wrap; }
.d-pill {
  padding:4px 11px; border-radius:var(--r-pill); font-size:11px; font-weight:600;
  border:1.5px solid #E4E8EF; cursor:pointer; color:#777; background:var(--white); transition:all .2s;
}
.d-pill.active { background:var(--navy); color:var(--white); border-color:var(--navy); }
.bk-confirm {
  background: var(--navy); color: var(--white);
  border-radius: 12px; padding: 16px 18px; margin-top: 8px;
}
.bk-confirm h4 { font-size:13px; font-weight:800; margin-bottom:10px; color:var(--teal); display:flex; align-items:center; gap:6px; }
.bk-row { display:flex; justify-content:space-between; font-size:12px; margin-bottom:5px; opacity:.85; }
.bk-row strong { opacity:1; color:var(--white); }
.bk-code { font-size:26px; font-weight:900; letter-spacing:3px; color:var(--teal); text-align:center; margin:12px 0; }
.chat-input-area {
  padding: 12px 14px; border-top: 1px solid #E4E8EF;
  display: flex; gap: 8px; align-items: center; background: var(--white);
}
.chat-input {
  flex:1; padding:10px 14px; border:1.5px solid #E4E8EF; border-radius:var(--r-pill);
  font-size:13px; outline:none; transition:border-color .2s; font-family:inherit; color:#1a1a2e;
}
.chat-input:focus { border-color: var(--teal); }
.chat-input::placeholder { color:#bbb; }
.btn-send {
  width:38px; height:38px; border-radius:50%; border:none;
  background:var(--teal); color:var(--navy); cursor:pointer;
  display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:background .2s;
}
.btn-send:hover { background:var(--teal-hover); }
.btn-send svg { width:15px; height:15px; }
.chat-foot { text-align:center; padding:6px; font-size:10px; color:#bbb; background:var(--white); }
.chat-foot strong { color:var(--teal); }

/* ── RESPONSIVE: CONTENT ── */
@media (max-width: 1024px) {
  .ticket-strip, .section, .pts-banner { padding-left: 28px; padding-right: 28px; }
  footer { padding: 48px 28px 32px; }
  .pts-inner { padding: 32px 36px; }
}
@media (max-width: 768px) {
  .ticket-strip { padding: 32px 20px 0; }
  .ticket-card  { flex-direction: column; align-items: flex-start; }
  .section      { padding: 36px 20px 0; }
  .deals-grid   { grid-template-columns: 1fr; }
  .pts-banner   { padding: 24px 20px; }
  .pts-inner    { flex-direction: column; gap: 24px; padding: 28px; }
  footer        { padding: 40px 20px 28px; }
  .footer-inner { grid-template-columns: 1fr 1fr; gap: 32px; }
  .s-row        { grid-template-columns: 1fr; }
}
@media (max-width: 480px) {
  .footer-inner  { grid-template-columns: 1fr; }
  .footer-bottom { flex-direction: column; gap: 8px; text-align: center; }
  .chat-window   { width: calc(100vw - 32px); right: 16px; }
  .deals-grid    { grid-template-columns: 1fr; }
}

/* ── RESPONSIVE: NAV + HERO ── */
@media (max-width: 1024px) {
  .nav  { padding: 0 28px; }
  .hero { padding: 60px 28px 80px; }
  .hero-content { gap: 48px; }
  .hero-title { font-size: 44px; }
}
@media (max-width: 768px) {
  .nav-links { display: none; }
  .nav { padding: 0 20px; }
  .hero { padding: 48px 20px 64px; min-height: auto; }
  .hero-content { grid-template-columns: 1fr; gap: 36px; }
  .hero-title { font-size: 38px; letter-spacing: -1.5px; }
  .hero-plane { display: none; }
  .hero-stats { gap: 24px; }
}
@media (max-width: 480px) {
  .hero-title { font-size: 32px; }
  .pts-chip { display: none; }
}

/* ── MOBILE VIEW CLASS OVERRIDES ── */
.mobile-view .desktop-item { display: none !important; }
.mobile-view .hamburger-btn { display: flex !important; }
.mobile-view .vt-icon-mobile { display: none !important; }
.mobile-view .vt-icon-desktop { display: block !important; }
.mobile-view .nav { padding: 0 20px; }
.mobile-view .nav-links { display: none; }
.mobile-view .nav-right { gap: 8px; }

/* Mobile hero */
.mobile-view .hero { padding: 48px 20px 64px; min-height: auto; }
.mobile-view .hero-content { grid-template-columns: 1fr !important; gap: 24px !important; }
.mobile-view .hero-left { min-width: 0; }
.mobile-view .hero-right { min-width: 0; width: 100%; }
.mobile-view .hero-title { font-size: 32px; letter-spacing: -1.5px; }
.mobile-view .hero-plane { display: none; }
.mobile-view .hero-stats { gap: 24px; }
.mobile-view .pts-chip { display: none !important; }
.mobile-view .search-card { padding: 20px; box-sizing: border-box; width: 100%; min-width: 0; }
.mobile-view .s-row { grid-template-columns: 1fr; }

/* Mobile main */
.mobile-view .ticket-strip { padding: 32px 20px 0; }
.mobile-view .ticket-card { flex-direction: column; align-items: flex-start; }
.mobile-view .section { padding: 36px 20px 0; }
.mobile-view .deals-grid { grid-template-columns: 1fr; }
.mobile-view .pts-banner { padding: 24px 20px; }
.mobile-view .pts-inner { flex-direction: column; gap: 24px; padding: 28px; }

/* Mobile footer */
.mobile-view footer { padding: 40px 20px 28px; }
.mobile-view .footer-inner { grid-template-columns: 1fr; gap: 32px; }
.mobile-view .footer-bottom { flex-direction: column; gap: 8px; text-align: center; }

/* Mobile chat */
.mobile-view .chat-window { width: calc(100vw - 32px); right: 16px; }
.mobile-view .chat-btn { bottom: 20px; right: 16px; padding: 11px 18px; font-size: 13px; }

/* ── PHONE SIMULATION ── */
body {
  margin: 0; padding: 0;
  transition: background-color 0.5s ease, padding 0.5s ease;
}
body.mobile-view {
  background: #1c1c1e;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  box-sizing: border-box;
}

#siteContent {
  width: 100%;
  position: relative;
  transition: max-width 0.5s cubic-bezier(.4,0,.2,1),
              border-radius 0.5s ease,
              box-shadow 0.5s ease;
  max-width: 100vw;
}
body.mobile-view #siteContent {
  max-width: 393px;
  border-radius: 54px;
  height: calc(100vh - 40px);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transform: translateZ(0);
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.07),
    0 0 0 2px rgba(255,255,255,.15),
    0 0 0 16px #111,
    0 0 0 18px rgba(255,255,255,.1),
    0 60px 120px rgba(0,0,0,.8);
}

#scrollContent {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
#scrollContent::-webkit-scrollbar { display: none; }

/* Phone status bar */
#phoneStatusBar {
  display: none;
  background: #000;
  height: 54px;
  padding: 14px 24px 0;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  position: relative;
  flex-shrink: 0;
}
body.mobile-view #phoneStatusBar { display: flex; }
#phoneClock {
  font-size: 15px; font-weight: 600; color: white;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  letter-spacing: -0.3px; position: relative; z-index: 1;
}
#phoneDI {
  position: absolute; top: 10px; left: 50%;
  transform: translateX(-50%);
  width: 120px; height: 34px;
  background: #000; border-radius: 20px;
}
#phoneStatusIcons {
  display: flex; align-items: center; gap: 5px;
  position: relative; z-index: 1;
}

/* Phone home bar */
#phoneHomeBar {
  display: none;
  height: 34px;
  background: var(--navy);
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 8px;
  flex-shrink: 0;
}
body.mobile-view #phoneHomeBar { display: flex; }
#phoneHomeBar::after {
  content: ''; display: block;
  width: 134px; height: 5px;
  background: rgba(255,255,255,.35);
  border-radius: 3px;
}

/* ── HIDE AGENTFORCE IN MOBILE VIEW ── */
.mobile-view #embeddedMessagingContainer,
.mobile-view #embeddedMessaging,
.mobile-view #embeddedMessagingFrame,
.mobile-view .embeddedServiceHelpButton,
.mobile-view .embeddedServiceSidebar,
.mobile-view .embeddedMessagingConversationButton { display: none !important; }

/* ── MOBILE PHONE CALL BUBBLE ── */
.mob-call-fab {
  display: none;
  position: fixed;
  bottom: 28px;
  right: 20px;
  z-index: 9999;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  border: none;
  background: var(--teal);
  color: white;
  padding: 14px 22px;
  border-radius: 30px;
  font-size: 16px;
  font-weight: 700;
  font-family: inherit;
  box-shadow: 0 4px 20px rgba(0,201,167,.45);
  white-space: nowrap;
}
.mobile-view .mob-call-fab {
  display: flex;
  position: absolute;
  bottom: 28px;
  right: 20px;
}
.mob-call-fab svg { width: 22px; height: 22px; fill: white; flex-shrink: 0; }

/* ── IPHONE CALL UI ── */
.iphone-call-ui {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 10000;
  background: linear-gradient(160deg, #1a1a2e 0%, #0d0d1a 60%, #0d2137 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 60px 32px 48px;
  transform: translateY(100%);
  transition: transform .35s cubic-bezier(.4,0,.2,1);
  visibility: hidden;
  pointer-events: none;
}
.iphone-call-ui.call-active {
  transform: translateY(0);
  visibility: visible;
  pointer-events: auto;
}
.call-avatar {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  background: linear-gradient(135deg, #00916e, #00C9A7);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 6px rgba(0,201,167,.2);
  margin-bottom: 18px;
}
.call-avatar svg { width: 64px; height: 64px; }
.call-name {
  font-size: 26px;
  font-weight: 700;
  color: white;
  letter-spacing: -.4px;
  margin-bottom: 6px;
  text-align: center;
}
.call-status {
  font-size: 14px;
  color: rgba(255,255,255,.55);
  letter-spacing: .2px;
}
.call-controls {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px 28px;
  width: 100%;
  max-width: 320px;
}
.c-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
  cursor: pointer;
  background: transparent;
  border: none;
  color: white;
  padding: 0;
}
.c-btn-disk {
  width: 62px;
  height: 62px;
  border-radius: 50%;
  background: rgba(255,255,255,.18);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .2s;
}
.c-btn.on .c-btn-disk { background: white; }
.c-btn.on .c-btn-disk svg { stroke: #0d0d1a !important; fill: #0d0d1a !important; }
.c-btn.on .c-btn-disk svg polygon { fill: #0d0d1a !important; stroke: none !important; }
.c-btn-disk svg {
  width: 24px; height: 24px;
  stroke: white; fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.c-btn span { font-size: 12px; color: rgba(255,255,255,.7); font-weight: 500; }
.c-btn.disabled { opacity: .35; pointer-events: none; }
.call-end-row { width: 100%; display: flex; justify-content: center; }
.call-end-btn {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  background: #FF3B30;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 4px 20px rgba(255,59,48,.45);
  transition: background .2s;
}
.call-end-btn:hover { background: #e0352b; }
.call-end-btn svg { width: 30px; height: 30px; }

</style>
</head>
