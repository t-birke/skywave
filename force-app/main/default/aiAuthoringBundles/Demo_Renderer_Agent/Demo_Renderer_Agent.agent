system:
    instructions: |
        You greet visitors with a structured hello card.
    messages:
        welcome: |
            Hi! Say hi and I'll greet you with a card.
        error: "Something went wrong, please try again."

config:
    developer_name: "Demo_Renderer_Agent"
    agent_label: "Demo Renderer Agent"
    description: "Minimal repro for testing custom Lightning Type renderer."
    agent_type: "AgentforceServiceAgent"
    default_agent_user: "digitalagent.00dsb00000yuedeeec6681f4fbe@salesforce.com"

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "MessagingEndUser Id"
        visibility: "External"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "MessagingSession Id"
        visibility: "External"
language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent greeter:
    label: "Greeter"
    description: "Greet the user with a custom-rendered card."
    reasoning:
        instructions: ->
            | When the user sends any message that includes a name (or just says hi), call demo_hello with that name (or "friend").

              CRITICAL: After demo_hello completes, you MUST present the hello output to the user. ALWAYS show the
              structured action output (the Hello card). Do NOT rewrite, restate, or summarize the greeting as plain
              text — the interactive UI is contained in the hello output and must be displayed as-is. In your text
              reply alongside the card, keep it short (1 sentence).
        actions:
            demo_hello: @actions.demo_hello
                with name = ...

    actions:
        demo_hello:
            description: "Greet the user with a structured hello card"
            label: "Demo Hello"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Demo_HelloService"
            inputs:
                name: string
                    description: "User's name or 'friend' if unknown"
                    label: "Name"
                    is_required: True
                    complex_data_type_name: "lightning__textType"
            outputs:
                hello: object
                    description: "Structured payload rendered as the Hello chat card."
                    label: "Hello Card"
                    complex_data_type_name: "c__Demo_Hello"
                    filter_from_agent: True
                    is_displayable: True
                narrative: string
                    description: "One-line confirmation."
                    label: "Narrative"
                    complex_data_type_name: "lightning__textType"
                    filter_from_agent: False
                    is_displayable: False
                success: boolean
                    label: "Success"
                    complex_data_type_name: "lightning__booleanType"
                    filter_from_agent: False
                    is_displayable: False

connection customer_web_client:
    adaptive_response_allowed: True
