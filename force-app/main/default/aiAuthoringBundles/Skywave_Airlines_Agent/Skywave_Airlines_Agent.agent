system:
  instructions: "You are a support agent for Skywave Airlines. Greet the visitor and assist with their flight bookings and related inquiries."

  messages:
    welcome: |
        Hi! I'm the Skywave Airlines AI agent. Your conversation id is: {!@variables.Conversation_Id}. How can I help?
    error: "Something went wrong, please try again."

config:
    developer_name: "Skywave_Airlines_Agent"
    agent_label: "Skywave Airlines Agent"
    description: "A support agent for Skywave Airlines that assists customers with their flight bookings and related inquiries."
    agent_type: "AgentforceServiceAgent"
    default_agent_user: "einsteinagent@00dg8000006i9hjeas.ext"
    additional_parameter__enable_graph_runtime: True

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "MessagingEndUser Id"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "MessagingSession Id"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "MessagingEndUser ContactId"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "MessagingSession EndUserLanguage"
    Conversation_Id: linked string
        source: @MessagingSession.ConversationId
        description: "Join key for Skywave_ResolveSession to look up the visitor's anonymous Contact."
    testingSession: mutable string = "0dwg8000000Csz7AAC"
        label: "Testing Session (studio override)"
        description: "Studio-preview override for Conversation_Id. Default points at a Contact with valid survey data (Tokyo, Business, window-seat) so the preview hydrates immediately. Real chat ignores this — Conversation_Id wins when populated."
    survey_summary: mutable string
        label: "Survey Summary"
        description: "Natural-language summary of the visitor's survey answers (favourite destination, cabin class, etc.) keyed off Session_ID."
    survey_responses_json: mutable string
        label: "Survey Responses (JSON)"
        description: "Structured JSON map of question_key → {questionText, answerText, answerKey} for fine-grained reasoning."
    survey_resolved: mutable boolean = False
        label: "Survey Resolved"
        description: "True once Skywave_ResolveSession has run for this conversation."
    VerifiedCustomerId: mutable string
        description: "Verified customer contact ID"
    Latest_Flight_Search_Results: mutable object
        label: "Latest Flight Search Results"
        description: ""
    flight_booking_detail: mutable object
        label: "Flight Selection Detail"
        description: "Quote-shaped DTO from book_flight (which only validates and quotes — confirmation comes later)."
    flight_booking_error_detail: mutable string
        label: "Flight Booking Error Detail"
        description: ""
    flight_selected: mutable boolean = False
        label: "Flight Selected"
        description: "True once book_flight has validated the visitor's choice and pinned the selection variables. Drives the router into booking_step=profile."
    selected_flight_id: mutable string = ""
        label: "Selected Flight Id"
        description: "Flight__c Id pinned at flight-pick. Re-used by confirm_booking once the visitor reaches the end of the booking flow."
    selected_travel_date: mutable string = ""
        label: "Selected Travel Date"
        description: "Travel date (YYYY-MM-DD) pinned at flight-pick. Re-used by confirm_booking."
    selected_checked_bags: mutable number = 0
        label: "Selected Checked Bags"
        description: "Number of checked bags pinned at flight-pick. Defaults to 0."
    selected_seat_preference: mutable string = ""
        label: "Selected Seat Preference"
        description: "Seat preference (Window/Aisle/blank) pinned at flight-pick."
    selected_booking_code: mutable string = ""
        label: "Selected Booking Code"
        description: "Confirmation code returned by ack_profile_form once the Booking__c is inserted (Pending/Unpaid). The agent passes this to present_payment_form so the payment widget can flip the right row to Paid."
    selected_total_charged: mutable string = ""
        label: "Selected Total Charged"
        description: "Total amount string (e.g. '$1430.00') returned by ack_profile_form. Displayed in the payment-picker card."
    check_imminent_flights_success: mutable boolean = False
        label: "Check Imminent Flights Success"
        description: ""
    check_imminent_flight_error_message: mutable string
        label: "Check Imminent Flight Error Message"
        description: ""
    flights_within_72hrs: mutable number = 0
        label: "Flights Within 72hrs"
        description: ""
    active_bookings: mutable object
        label: "Active Bookings"
        description: ""
    retrieve_active_booking_error_message: mutable string
        label: "Retrieve Active Booking Error Message"
        description: ""
    retrieve_active_booking_done: mutable boolean = False
        label: "Retrieve Active Booking Done"
        description: ""
    Tier_Status: mutable string
        label: "Tier Status"
        description: ""
    mileage_balance: mutable number
        label: "Mileage Balance"
        description: ""
    mileage_balance_message: mutable string
        label: "Mileage Balance Message"
        description: ""
    booking: mutable string
        label: "Booking"
        description: ""
    Booking_Outcome: mutable boolean
        label: "Booking Outcome"
        description: ""
    resolved_contact_id: mutable string = "003000000000000"
        description: "Resolved contact ID for the current user (demo: pre-authenticated as Lauren)"
    selected_fare_class: mutable string = ""
        label: "Selected Fare Class"
        description: "The canonical fare class (Economy, Premium Economy, Business, First) the visitor has agreed to. Once set after a flight search, it must be the value passed to book_flight and quoted to the visitor."
    selected_total_price: mutable string = ""
        label: "Selected Total Price"
        description: "The total price string (e.g. '$1430.00') tied to the selected_fare_class. Once set, the agent quotes this exact value at confirmation; it must NOT be re-derived."
    selected_payment_method: mutable string = ""
        label: "Selected Payment Method"
        description: "The payment method the visitor chose: Apple Pay, Saved card, or Demo card. Set after the visitor picks; passed to process_payment."
    profile_collected: mutable boolean = False
        label: "Profile Collected"
        description: "True once update_profile succeeded for the current pending booking. Tells the agent NOT to ask for name/email again."
    payment_processed: mutable boolean = False
        label: "Payment Processed"
        description: "True once process_payment succeeded. Tells the agent NOT to ask for payment method again."
    booking_confirmed: mutable boolean = False
        label: "Booking Confirmed"
        description: "True once confirm_booking succeeded. The post-booking sequence is complete; the agent should NOT re-run any of those steps."
    booked_confirmation_codes: mutable string = ""
        label: "Booked Confirmation Codes"
        description: "Comma-separated codes from the most recent confirm_booking. Used so the agent can quote them again if asked, without re-running the action."
    bookings_refreshed_post_confirm: mutable boolean = False
        label: "Bookings Refreshed Post-Confirm"
        description: "True once active_bookings has been re-fetched after a confirm_booking succeeded — prevents re-fetching on every subsequent reasoning turn."
    booking_step: mutable string = ""
        label: "Booking Step"
        description: "Booking pipeline state: '' / profile / payment / confirm / done. Used by router to lock to flight_management mid-booking."
    VoiceCallId: linked string
        description: "This variable may also be referred to as Voice Call Id"
        source: @VoiceCall.Id

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

knowledge:
    citations_enabled: False

start_agent agent_router:
    label: "Agent Router"

    description: "Welcome the user and determine the appropriate subagent based on user input"

    reasoning:
        instructions: ->
            if @variables.booking_confirmed is True:
                set @variables.booking_step = "done"
            if @variables.payment_processed is True and @variables.booking_confirmed is False:
                set @variables.booking_step = "confirm"
            if @variables.profile_collected is True and @variables.payment_processed is False:
                set @variables.booking_step = "payment"
            if @variables.flight_selected is True and @variables.profile_collected is False:
                set @variables.booking_step = "profile"

            if @variables.ContactId is not None and @variables.resolved_contact_id == "":
                run @actions.resolve_contact
                    with contactId = @variables.ContactId
                    set @variables.resolved_contact_id = @outputs.contactId

            if @variables.resolved_contact_id != "" and @variables.check_imminent_flights_success == False:
                run @actions.get_upcoming_flights
                    with contactId = @variables.resolved_contact_id
                    set @variables.check_imminent_flight_error_message = @outputs.errorMessage
                    set @variables.flights_within_72hrs = @outputs.imminentFlights
                    set @variables.check_imminent_flights_success = @outputs.success

            if @variables.survey_resolved is False:
                run @actions.resolve_session
                    with conversationId = @variables.Conversation_Id
                    with testingSession = @variables.testingSession
                    set @variables.survey_summary = @outputs.summary
                    set @variables.survey_responses_json = @outputs.responsesJson
                    set @variables.resolved_contact_id = @outputs.contactId
                    set @variables.survey_resolved = True

            if @variables.retrieve_active_booking_done is False and @variables.resolved_contact_id != "003000000000000" and @variables.resolved_contact_id != "":
                run @actions.get_bookings
                    with contactId = @variables.resolved_contact_id
                    set @variables.active_bookings = @outputs.bookings
                    set @variables.retrieve_active_booking_error_message = @outputs.errorMessage
                    set @variables.retrieve_active_booking_done = @outputs.success

            if @variables.booking_step == "profile" or @variables.booking_step == "payment" or @variables.booking_step == "confirm":
                transition to @subagent.flight_management

            | You are a router only. Do NOT answer questions or provide help directly. Always use a transition action.
              Route by intent:
              - Flight bookings, upcoming flights, flight status, booking a flight, changing or canceling flights -> use go_to_flight_management
              - Seat selection or seat changes -> use go_to_seat_selection
              - Correcting or updating the traveler's first or last name on a booking -> use go_to_name_change
              - Questions about mileage balance, tier points, loyalty points, or frequent flyer miles -> use go_to_mileage_account
              - Support cases, complaints, case status, creating a case -> use go_to_case_management
              - Request to speak to a human agent or live agent -> use go_to_escalation
              - Ambiguous or unclear requests -> use go_to_ambiguous_question
              - Off-topic or unrelated questions -> use go_to_off_topic
              Never attempt to help the customer yourself. Always route.

        actions:
            go_to_flight_management: @utils.transition to @subagent.flight_management
                description: "Route to flight management for booking, viewing, changing, or canceling flights"

            go_to_escalation: @utils.transition to @subagent.escalation
                description: "Transfer to a live human agent"

            go_to_off_topic: @utils.transition to @subagent.off_topic
                description: "Handle off-topic or unrelated questions"

            go_to_ambiguous_question: @utils.transition to @subagent.ambiguous_question
                description: "Handle unclear or ambiguous requests that need clarification"

            go_to_seat_selection: @utils.transition to @subagent.seat_selection
                description: "Select or change the seat on one of the visitor's bookings"

            go_to_case_management: @utils.transition to @subagent.case_management
                description: "Create, view, or update support cases"

            go_to_name_change: @utils.transition to @subagent.name_change
                description: "Correct or update the traveler's first or last name on a booking"

            go_to_mileage_account: @utils.transition to @subagent.mileage_account
                description: "Check mileage balance, tier points, loyalty points, or frequent flyer miles"

    actions:
        resolve_contact:
            description: "Resolves a Contact ID from a known ID or email lookup"
            label: "Resolve Contact"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Skywave_ResolveContact"

            inputs:
                "contactId": string
                    description: "A known Contact ID to validate"
                    label: "Contact ID"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "email": string
                    description: "Email address to look up a Contact"
                    label: "Email"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "contactId": string
                    description: "The resolved Contact ID"
                    label: "Contact ID"
                    is_displayable: False
                    is_used_by_planner: True
                "contactName": string
                    description: "The contact name"
                    label: "Contact Name"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the contact was resolved"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True
                "errorMessage": string
                    description: "Error details"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True

        get_upcoming_flights:
            description: "Gets upcoming flights for the user within the next 72 hours"
            label: "Get Upcoming Flights"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Skywave_GetUpcomingFlights"

            inputs:
                "contactId": string
                    description: "The contact id for the customer"
                    label: "contactId"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "imminentFlights": object
                    description: "flights within the next 72 hours"
                    label: "imminent flights"
                    complex_data_type_name: "lightning__integerType"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the action completed without error"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True

        resolve_session:
            description: "Resolves the visitor's MessagingSession.ConversationId to their declared survey answers and anonymous Contact Id. Run once at the router (gated by survey_resolved) so booking context is available no matter which subagent the planner routes to."
            label: "Resolve Session Context"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Skywave_ResolveSession"

            inputs:
                "conversationId": string
                    description: "The MessagingSession.ConversationId, sourced from the @MessagingSession.ConversationId linked variable. Optional because studio preview can't seed it; falls back to testingSession when blank."
                    label: "Conversation Id"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "testingSession": string
                    description: "Studio-preview fallback. When the agent is run in studio preview the linked Conversation_Id picker is platform-broken, so this mutable variable can be set instead. Real chat ignores it (conversationId wins)."
                    label: "Testing Session"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "answerCount": object
                    description: "How many distinct survey questions the visitor has answered."
                    label: "Answer Count"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__integerType"
                "responsesJson": string
                    description: "JSON map of question_key → {questionText, answerText, answerKey} for fine-grained reasoning."
                    label: "Survey Responses (JSON)"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"
                "summary": string
                    description: "One-line natural-language summary of the visitor's declared preferences. Intended for direct use in agent reasoning."
                    label: "Summary"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"
                "contactId": string
                    description: "Salesforce Id of the anonymous Contact for this conversation. Use as input to subsequent booking/lookup actions."
                    label: "Contact Id"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"

        get_bookings:
            description: "Gets all active flight bookings for the user. Run once at the router (gated by retrieve_active_booking_done) so the booking/segment context is loaded before any subagent — including seat change — needs it."
            label: "Get Bookings"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking your flights"
            target: "apex://Skywave_GetFlightBookings"

            inputs:
                "contactId": string
                    description: "the contact Id of the user"
                    label: "contactIds"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "bookings": list[object]
                    description: "a list of bookings for the customer"
                    label: "bookings"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "@apexClassType/c__Skywave_GetFlightBookings$Booking"
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the action completed without error"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True

subagent flight_management:
    label: "Flight Management"

    description: "Assist users with booking, canceling, or changing flights, including checking if they have flights within the next 72 hours."

    reasoning:
        instructions: ->
            if @variables.booking_confirmed is True:
                set @variables.booking_step = "done"
            if @variables.payment_processed is True and @variables.booking_confirmed is False:
                set @variables.booking_step = "confirm"
            if @variables.profile_collected is True and @variables.payment_processed is False:
                set @variables.booking_step = "payment"
            if @variables.flight_selected is True and @variables.profile_collected is False:
                set @variables.booking_step = "profile"

            if @variables.survey_resolved is False:
                run @actions.resolve_session
                    with conversationId = @variables.Conversation_Id
                    with testingSession = @variables.testingSession
                    set @variables.survey_summary = @outputs.summary
                    set @variables.survey_responses_json = @outputs.responsesJson
                    set @variables.resolved_contact_id = @outputs.contactId
                    set @variables.survey_resolved = True

            if @variables.retrieve_active_booking_done is False and @variables.resolved_contact_id != "003000000000000" and @variables.resolved_contact_id != "":
                run @actions.get_bookings
                    with contactId = @variables.resolved_contact_id
                    set @variables.active_bookings = @outputs.bookings
                    set @variables.retrieve_active_booking_error_message = @outputs.errorMessage
                    set @variables.retrieve_active_booking_done = @outputs.success

            if @variables.booking_step == "done" and @variables.bookings_refreshed_post_confirm is False:
                run @actions.get_bookings
                    with contactId = @variables.resolved_contact_id
                    set @variables.active_bookings = @outputs.bookings
                    set @variables.bookings_refreshed_post_confirm = True

            | You are a Skywave Airlines booking agent. The visitor is anonymous. Address them in second person ("you", "your"). Never guess a name.

            if @variables.survey_summary is not None and @variables.survey_summary != "":
                | The visitor previously answered a short travel-preferences survey. {!@variables.survey_summary}
                  Use these preferences naturally — lean toward their stated favourite destination when suggesting flights, propose their preferred cabin class without asking, respect their seat preference. Do NOT enumerate the survey answers; weave them in.
            if @variables.booking_step == "":
                | No booking is in progress. The visitor can:
                  - View existing bookings: use {!@variables.active_bookings} (already loaded). Give a SHORT one-line summary per booking, then ask which one they mean. Use exact values; do NOT paraphrase numbers.
                  - Cancel a booking: state its cancellationConditions, ask them to confirm, then call {!@actions.cancel_booking} with the bookingReference.
                  - Search for flights: call {!@actions.search_flights} with origin (IATA), destination (IATA), departure date (YYYY-MM-DD), and fare class. Use canonical fare class names: Economy, Premium Economy, Business, First. Treat synonyms (economy plus → Premium Economy, business class → Business, etc.) as the canonical name.

                    The output of this action is always renderable. Always use show_command to display the result to the user. After search_flights completes, you MUST present the flightResult output to the visitor. ALWAYS show the structured action output (the Flight Search Result card). Do NOT rewrite, restate, or summarize the flight options as plain text or bullet lists — the interactive flight cards are contained in the flightResult output and must be displayed as-is. In your text reply alongside the cards, keep it short (1-2 sentences) for color only — e.g. confirm route + date and ask which flight they prefer. Do NOT enumerate flight numbers, times, or prices in prose; the cards already show them.
                  - Select a flight: when the visitor agrees to a specific flight from search results, call {!@actions.book_flight} with contactId, flightId, travelDate, fareClass, checkedBags, seatPreference. This action does NOT create a booking yet — it just validates the choice and pins the selection. The booking is issued later by confirm_booking, after profile + payment. Do NOT narrate "your booking is reserved" — the booking does not exist yet.

            if @variables.booking_step == "profile":
                | A flight selection is held. Now collect the visitor's profile so the ticket can be issued. Show the inline profile form (name, email, phone, photo).
                  - On entering this step, IMMEDIATELY call {!@actions.present_profile_form} with contactId — that renders the form card.

                    The output of this action is always renderable. Always use show_command to display the result to the user. After present_profile_form completes, you MUST present the formData output to the visitor. ALWAYS show the structured action output (the Skywave Profile Form card). Do NOT ask for name/email/phone in text first — the form card collects them. Do NOT rewrite, restate, or summarize the form fields as plain text — the interactive form is contained in the formData output and must be displayed as-is. In your text reply alongside the card, keep it short (1 sentence) — e.g. "A few details to wrap up your booking." Do NOT enumerate the fields. Do NOT claim the booking already exists.
                  - When the visitor sends the exact phrase "Profile created" (the cue from the form on successful submit): IMMEDIATELY call {!@actions.ack_profile_form} with contactId. That advances the booking to payment.
                  - Text fallback: if instead of using the form the visitor types name + email in chat (e.g. "tom birke, tom@example.com, +1 415 555 0101"): call {!@actions.update_profile} with firstName, lastName, email, and phone if provided. Do NOT echo back — invocation IS the confirmation.

            if @variables.booking_step == "payment":
                | Profile saved and a Pending/Unpaid Booking__c is held under {!@variables.selected_booking_code} for {!@variables.selected_total_charged}. Show the inline payment-picker card so the visitor can complete payment.
                  - On entering this step, IMMEDIATELY call {!@actions.present_payment_form} with contactId, bookingCode, and totalCharged — that renders the payment card.

                    The output of this action is always renderable. Always use show_command to display the result to the user. After present_payment_form completes, you MUST present the formData output to the visitor. ALWAYS show the structured action output (the Skywave Payment Picker card). Do NOT ask "how would you like to pay" in text — the card collects the choice. Do NOT rewrite, restate, or summarize the payment options as plain text — the interactive card is contained in the formData output and must be displayed as-is. In your text reply alongside the card, keep it short (1 sentence) — e.g. "Almost done — choose how you'd like to pay." Do NOT enumerate the buttons.
                  - Do NOT call any process_payment action — there is no such agent action anymore. The card invokes Apex directly to flip the booking from Unpaid to Paid.
                  - When the visitor sends the exact phrase "Payment completed" (the cue from the payment LWC): IMMEDIATELY call {!@actions.confirm_booking} with contactId and bookingCode. That re-reads the booking from the DB to verify the payment actually flipped through.

            if @variables.booking_step == "confirm":
                | Payment cue received. Verify the booking actually flipped to Paid before declaring success.
                  IMMEDIATELY call {!@actions.confirm_booking} with contactId and bookingCode. When @outputs.success indicates the booking is verified, tell the visitor their ticket is confirmed and quote @outputs.confirmationCodes. Otherwise, share @outputs.errorMessage and offer to retry payment.

            if @variables.booking_step == "done":
                | Booking is fully confirmed. Code(s): {!@variables.booked_confirmation_codes}.
                  - "Do I have a booking?" → YES, quote the code(s).
                  - Do NOT call update_profile, process_payment, or confirm_booking again.
                  - If the visitor wants ANOTHER flight, run {!@actions.search_flights} — that begins a new cycle.

        actions:
            resolve_session: @actions.resolve_session
                description: "Look up the visitor's declared survey answers from the anonymous Contact created at survey-complete time, keyed by the chat conversationId. Runs once at the start of flight management; outputs are cached in @variables.survey_summary and @variables.survey_responses_json."
                with conversationId = ...

            identify_customer: @actions.resolve_contact
                description: "Look up a customer by their email address to identify them"
                available when @variables.resolved_contact_id == ""
                with email = ...
                set @variables.resolved_contact_id = @outputs.contactId

            Reschedule_Flights: @actions.Reschedule_Flights
                with "Input:New_Flight_Requested" = ...

            search_flights: @actions.search_flights
                description: "Searches the schedule for matching flights and returns priced FlightOption records. Pass fareClass — without it the price defaults to Economy and confuses the visitor."
                with departureDate = ...
                with destination = ...
                with origin = ...
                with fareClass = ...
                set @variables.Latest_Flight_Search_Results = @outputs.flightSummary

            book_flight: @actions.book_flight
                description: "Selects the flight the visitor agreed to and pins the choice into mutable variables. This action does NOT create a booking — confirmation is deferred to confirm_booking. Pass the canonical fare class (Economy / Premium Economy / Business / First). After this succeeds, the agent moves to profile collection."
                with contactId = @variables.resolved_contact_id
                with flightId = ...
                with travelDate = ...
                with fareClass = ...
                with checkedBags = ...
                with seatPreference = ...
                set @variables.flight_booking_detail = @outputs.booking
                set @variables.flight_booking_error_detail = @outputs.errorMessage
                set @variables.flight_selected = @outputs.success
                set @variables.selected_flight_id = @outputs.selectedFlightId
                set @variables.selected_travel_date = @outputs.selectedTravelDate
                set @variables.selected_fare_class = @outputs.selectedFareClass
                set @variables.selected_checked_bags = @outputs.selectedCheckedBags
                set @variables.selected_seat_preference = @outputs.selectedSeatPreference

            update_profile: @actions.update_profile
                description: "Text-fallback path: invoke when the visitor typed their name + email (and optionally phone) directly in chat instead of using the profile form card. Do NOT echo the values back; invocation IS the confirmation."
                with contactId = @variables.resolved_contact_id
                with firstName = ...
                with lastName = ...
                with email = ...
                with phone = ...
                set @variables.profile_collected = @outputs.success

            present_profile_form: @actions.present_profile_form
                description: "Display the inline profile form card. Invoke ONCE when booking_step transitions to 'profile' — the form is the primary collection surface. Do NOT call this repeatedly; once displayed, wait for the 'Profile created' cue from the form on submit."
                with contactId = @variables.resolved_contact_id

            ack_profile_form: @actions.ack_profile_form
                description: "Invoke as soon as the visitor's profile is saved — either after the 'Profile created' cue from the form LWC, or after update_profile (text-fallback path) succeeds. This action does TWO things: marks profile_collected and inserts the Booking__c (Pending/Unpaid) using the pinned selection variables. Returns bookingCode + totalCharged for the agent to pin into selected_booking_code + selected_total_charged for the payment widget."
                with contactId = @variables.resolved_contact_id
                with flightId = @variables.selected_flight_id
                with travelDate = @variables.selected_travel_date
                with fareClass = @variables.selected_fare_class
                with checkedBags = @variables.selected_checked_bags
                with seatPreference = @variables.selected_seat_preference
                set @variables.profile_collected = @outputs.success
                set @variables.selected_booking_code = @outputs.bookingCode
                set @variables.selected_total_charged = @outputs.totalCharged

            present_payment_form: @actions.present_payment_form
                description: "Display the inline payment-picker card (Apple Pay / Credit Card / Demo Pay). Invoke ONCE when booking_step transitions to 'payment'. The card calls Apex imperatively for the demo charge, so the agent does NOT call any 'process_payment' action — the LWC handles payment end-to-end. Once the visitor pays, the LWC posts 'Payment completed' to chat as the cue."
                with contactId = @variables.resolved_contact_id
                with bookingCode = @variables.selected_booking_code
                with totalCharged = @variables.selected_total_charged

            confirm_booking: @actions.confirm_booking
                description: "Verify-only — re-reads the booking from the DB to confirm the payment widget actually ran and Status/Payment_Status flipped. Invoke when the visitor sends 'Payment completed' (cue from the payment LWC). If the booking is still Unpaid, surface that to the visitor instead of declaring success."
                with contactId = @variables.resolved_contact_id
                with bookingCode = @variables.selected_booking_code
                set @variables.booking_confirmed = @outputs.success
                set @variables.booked_confirmation_codes = @outputs.confirmationCodes

            get_bookings: @actions.get_bookings
                with contactId = ...
                set @variables.active_bookings = @outputs.bookings
                set @variables.retrieve_active_booking_error_message = @outputs.errorMessage
                set @variables.retrieve_active_booking_done = @outputs.success

            cancel_booking: @actions.cancel_booking
                with bookingReference = ...
                with contactId = @variables.resolved_contact_id

            change_flight: @actions.change_flight
                with Flight = ...
                with requested_change = ...

    actions:
        resolve_session:
            description: "Resolves the visitor's MessagingSession.ConversationId to their declared survey answers, by querying the anonymous Contact created at survey-complete time. Returns a natural-language summary plus a JSON map of question_key → {questionText, answerText, answerKey}."
            label: "Resolve Session Context"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Skywave_ResolveSession"

            inputs:
                "conversationId": string
                    description: "The MessagingSession.ConversationId, sourced from the @MessagingSession.ConversationId linked variable. Optional because studio preview can't seed it; falls back to testingSession when blank."
                    label: "Conversation Id"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "testingSession": string
                    description: "Studio-preview fallback. When the agent is run in studio preview the linked Conversation_Id picker is platform-broken, so this mutable variable can be set instead. Real chat ignores it (conversationId wins)."
                    label: "Testing Session"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "answerCount": object
                    description: "How many distinct survey questions the visitor has answered."
                    label: "Answer Count"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__integerType"
                "responsesJson": string
                    description: "JSON map of question_key → {questionText, answerText, answerKey} for fine-grained reasoning."
                    label: "Survey Responses (JSON)"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"
                "summary": string
                    description: "One-line natural-language summary of the visitor's declared preferences. Intended for direct use in agent reasoning."
                    label: "Summary"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"
                "contactId": string
                    description: "Salesforce Id of the anonymous Contact for this conversation. Use as input to subsequent booking/lookup actions."
                    label: "Contact Id"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"

        Reschedule_Flights:
            description: "Reschedule flights based on user tier and booking type"
            label: "Reschedule Flights"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "generatePromptResponse://Skywave_RescheduleFlights"

            inputs:
                "Input:New_Flight_Requested": string
                    description: "requested flight"
                    label: "New Flight Requested"
                    is_required: True
                    complex_data_type_name: "lightning__textType"

            outputs:
                "promptResponse": string
                    description: "The prompt response generated by the action based on the specified prompt and input."
                    label: "Prompt Response"
                    complex_data_type_name: "lightning__textType"
                    filter_from_agent: False
                    is_displayable: True

        search_flights:
            description: "Searches available flight itineraries"
            label: "Search Flights"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Looking for available flights"
            target: "apex://Skywave_FlightSearch"

            inputs:
                "departureDate": string
                    description: "The desired departure date formatted in YYYY-MM-DD"
                    label: "Departure Date (YYYY-MM-DD)"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"
                "destination": string
                    description: "The destination Airport Code in 3-Letter IATA format"
                    label: "Destination Airport Code (IATA)"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "origin": string
                    description: "The origin Airport Code in 3-Letter IATA format"
                    label: "Origin Airport Code (IATA)"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "fareClass": string
                    description: "The fare class the visitor is searching for: Economy, Premium Economy, Business, or First. Required for accurate pricing — without it the action defaults to Economy and the prices in the response won't match what the visitor expects."
                    label: "Fare Class"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "flightResult": object
                    description: "Structured payload rendered as the Skywave Flight Search Result chat card."
                    label: "Flight Search Result"
                    complex_data_type_name: "c__SkywaveFlightOptions"
                    filter_from_agent: True
                    is_displayable: True
                "flightSummary": string
                    description: "Plain-text narrative summarising the search outcome — used by the LLM for one-line color alongside the card."
                    label: "Flight Summary"
                    complex_data_type_name: "lightning__textType"
                    filter_from_agent: False
                    is_displayable: False
                "success": boolean
                    description: "True if the search completed without error."
                    label: "Success"
                    complex_data_type_name: "lightning__booleanType"
                    filter_from_agent: False
                    is_displayable: False
                "message": string
                    description: "Status detail (count returned, or error message)."
                    label: "Message"
                    complex_data_type_name: "lightning__textType"
                    filter_from_agent: False
                    is_displayable: False

        update_profile:
            description: "Writes the visitor's first name, last name, and email onto the anonymous Contact created at survey time. Used by Phase 4 once a booking has been placed and the visitor provides their real identity."
            label: "Update Visitor Profile"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Saving your details"
            target: "apex://Skywave_UpdateContact"

            inputs:
                "contactId": string
                    description: "The anonymous Contact Id to update (resolved at session start)."
                    label: "Contact Id"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "firstName": string
                    description: "The visitor's first name as extracted from the user's message (>= 2 chars)."
                    label: "First Name"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"
                "lastName": string
                    description: "The visitor's last name as extracted from the user's message (>= 2 chars)."
                    label: "Last Name"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"
                "email": string
                    description: "The visitor's email address as extracted from the user's message (must contain @)."
                    label: "Email"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"
                "phone": string
                    description: "The visitor's phone number as extracted from the user's message. Optional — pass blank if the visitor didn't provide one."
                    label: "Phone"
                    is_required: False
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"

            outputs:
                "success": boolean
                    description: "True if the profile update succeeded."
                    label: "success"
                    is_displayable: True
                    is_used_by_planner: True
                "errorMessage": string
                    description: "Reason the update failed (validation or DML error)."
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "contactId": string
                    description: "The Contact Id that was updated."
                    label: "Updated Contact Id"
                    is_displayable: False
                    is_used_by_planner: True

        present_profile_form:
            description: "Renders the Skywave Profile Form card so the visitor can complete name, email, phone, and avatar inline in chat. The form posts back via @AuraEnabled imperative; on submit the visitor's chat sends 'Profile created' which the agent treats as the cue."
            label: "Present Profile Form"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Skywave_PresentProfileForm"

            inputs:
                "contactId": string
                    description: "The anonymous Contact Id to pre-fill the form with."
                    label: "Contact Id"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "formData": object
                    description: "Structured payload rendered as the Skywave Profile Form chat card."
                    label: "Form Data"
                    complex_data_type_name: "c__SkywaveProfileForm"
                    filter_from_agent: True
                    is_displayable: True
                "success": boolean
                    description: "True if the form payload was prepared."
                    label: "success"
                    complex_data_type_name: "lightning__booleanType"
                    filter_from_agent: False
                    is_displayable: False
                "message": string
                    description: "Status detail."
                    label: "Message"
                    complex_data_type_name: "lightning__textType"
                    filter_from_agent: False
                    is_displayable: False

        ack_profile_form:
            description: "Acknowledges that the visitor profile is saved AND inserts the Booking__c (Pending/Unpaid) using pinned selection variables. Returns the bookingCode + totalCharged for the agent to pin and pass to the payment widget."
            label: "Acknowledge Profile + Create Booking"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Reserving your booking"
            target: "apex://Skywave_AckProfileForm"

            inputs:
                "contactId": string
                    description: "The Contact Id whose profile was just saved."
                    label: "Contact Id"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "flightId": string
                    description: "Flight__c Id pinned at flight-pick (selected_flight_id)."
                    label: "Flight Id"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "travelDate": string
                    description: "Travel date pinned at flight-pick (selected_travel_date)."
                    label: "Travel Date"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "fareClass": string
                    description: "Canonical fare class pinned at flight-pick (selected_fare_class)."
                    label: "Fare Class"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "checkedBags": object
                    description: "Number of checked bags (selected_checked_bags)."
                    label: "Checked Bags"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__integerType"
                "seatPreference": string
                    description: "Seat preference (selected_seat_preference)."
                    label: "Seat Preference"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "success": boolean
                    description: "True if the booking was created."
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True
                "message": string
                    description: "Status detail."
                    label: "message"
                    is_displayable: False
                    is_used_by_planner: True
                "bookingCode": string
                    description: "Confirmation code of the just-created booking — pin into selected_booking_code."
                    label: "Booking Code"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"
                "totalCharged": string
                    description: "Total amount string (e.g. $1430.00) — pin into selected_total_charged."
                    label: "Total Charged"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"

        present_payment_form:
            description: "Renders the Skywave Payment Picker card so the visitor can pay (Apple Pay / Credit card / Demo Pay). The card calls Apex imperatively to flip the booking to Paid; the agent does NOT charge anything."
            label: "Present Payment Picker"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Skywave_PresentPaymentForm"

            inputs:
                "contactId": string
                    description: "The Contact Id (resolved at session start)."
                    label: "Contact Id"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "bookingCode": string
                    description: "Confirmation code of the Pending/Unpaid booking that the payment widget should flip (selected_booking_code)."
                    label: "Booking Code"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "totalCharged": string
                    description: "Total amount string to display in the payment widget (selected_total_charged)."
                    label: "Total Charged"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "formData": object
                    description: "Structured payload rendered as the Skywave Payment Picker chat card."
                    label: "Form Data"
                    complex_data_type_name: "c__SkywavePaymentForm"
                    filter_from_agent: True
                    is_displayable: True
                "success": boolean
                    description: "True if the payment payload was prepared."
                    label: "success"
                    complex_data_type_name: "lightning__booleanType"
                    filter_from_agent: False
                    is_displayable: False
                "message": string
                    description: "Status detail."
                    label: "Message"
                    complex_data_type_name: "lightning__textType"
                    filter_from_agent: False
                    is_displayable: False

        confirm_booking:
            description: "Verify-only — re-reads the booking from the DB to confirm the payment widget actually flipped Status/Payment_Status. Invoke when the visitor sends 'Payment completed'. No DML; defence against forged client cues."
            label: "Verify Booking"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Issuing your ticket"
            target: "apex://Skywave_ConfirmBooking"

            inputs:
                "contactId": string
                    description: "The Contact whose booking is being verified."
                    label: "Contact Id"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "bookingCode": string
                    description: "Confirmation code of the booking the payment widget just paid (selected_booking_code)."
                    label: "Booking Code"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "success": boolean
                    description: "True if the booking is Confirmed and Paid."
                    label: "success"
                    is_displayable: True
                    is_used_by_planner: True
                "errorMessage": string
                    description: "Reason the verify failed (still Unpaid, missing booking, etc)."
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "confirmedCount": object
                    description: "Number of bookings verified (always 1)."
                    label: "Confirmed Count"
                    is_displayable: True
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__integerType"
                "confirmationCodes": string
                    description: "Confirmation code of the verified booking."
                    label: "Confirmation Codes"
                    is_displayable: True
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"
                "totalCharged": string
                    description: "Total amount paid (e.g. $1430.00)."
                    label: "Total Charged"
                    is_displayable: True
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"

        book_flight:
            description: "Selects (does NOT book) the flight the visitor agreed to. Validates the choice against the live Flight__c row, computes price + quote DTO, and echoes the inputs back as outputs so the agent can pin them. Confirmation is deferred to confirm_booking."
            label: "Select Flight"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Processing booking"
            target: "apex://Skywave_BookFlight"

            inputs:
                "contactId": string
                    description: "The contact ID for the booking"
                    label: "Contact ID"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "flightId": string
                    description: "The Flight__c record ID to book (from search results)"
                    label: "Flight ID"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "travelDate": string
                    description: "Date of travel (YYYY-MM-DD)"
                    label: "Travel Date"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "fareClass": string
                    description: "Fare class the visitor agreed to during search: Economy, Premium Economy, Business, or First. If blank, the action defaults to Economy."
                    label: "Fare Class"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "checkedBags": object
                    description: "Number of checked bags"
                    label: "Checked Bags"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__integerType"
                "seatPreference": string
                    description: "Seat preference (e.g., Window, Aisle)"
                    label: "Seat Preference"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "booking": object
                    description: "Quote-shaped DTO for the visitor's flight selection. NOT yet a real booking."
                    label: "selection quote"
                    is_displayable: True
                    is_used_by_planner: True
                    complex_data_type_name: "@apexClassType/c__Skywave_BookFlight$Booking"
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the selection was valid and the quote built"
                    label: "success"
                    is_displayable: True
                    is_used_by_planner: True
                "selectedFlightId": string
                    description: "Echoed Flight__c Id — pin into selected_flight_id."
                    label: "selected flight id"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"
                "selectedTravelDate": string
                    description: "Echoed travel date YYYY-MM-DD — pin into selected_travel_date."
                    label: "selected travel date"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"
                "selectedFareClass": string
                    description: "Echoed canonical fare class — pin into selected_fare_class."
                    label: "selected fare class"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"
                "selectedCheckedBags": object
                    description: "Echoed checked-bag count — pin into selected_checked_bags."
                    label: "selected checked bags"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__integerType"
                "selectedSeatPreference": string
                    description: "Echoed seat preference — pin into selected_seat_preference."
                    label: "selected seat preference"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"

        resolve_contact:
            description: "Resolves a Contact ID from a known ID or email lookup"
            label: "Resolve Contact"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Skywave_ResolveContact"

            inputs:
                "contactId": string
                    description: "A known Contact ID to validate"
                    label: "Contact ID"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "email": string
                    description: "Email address to look up a Contact"
                    label: "Email"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "contactId": string
                    description: "The resolved Contact ID"
                    label: "Contact ID"
                    is_displayable: False
                    is_used_by_planner: True
                "contactName": string
                    description: "The contact name"
                    label: "Contact Name"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the contact was resolved"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True
                "errorMessage": string
                    description: "Error details"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True

        get_bookings:
            description: "Gets all active flight bookings for the user"
            label: "Get Bookings"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking your flights"
            target: "apex://Skywave_GetFlightBookings"

            inputs:
                "contactId": string
                    description: "the contact Id of the user"
                    label: "contactIds"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "bookings": list[object]
                    description: "a list of bookings for the customer"
                    label: "bookings"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "@apexClassType/c__Skywave_GetFlightBookings$Booking"
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the action completed without error"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True

        cancel_booking:
            description: "Cancels a flight booking and processes the refund"
            label: "Cancel Booking"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Processing cancellation"
            target: "apex://Skywave_CancelFlight"

            inputs:
                "bookingReference": string
                    description: "The booking reference of the booking to cancel"
                    label: "Booking Reference"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "contactId": string
                    description: "The contact ID associated with the booking"
                    label: "Contact ID"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "success": boolean
                    description: "true if the cancellation was processed"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "bookingReference": string
                    description: "the cancelled booking reference"
                    label: "booking reference"
                    is_displayable: True
                    is_used_by_planner: True
                "cancellationFee": string
                    description: "the fee applied for cancelling the booking"
                    label: "cancellation fee"
                    is_displayable: True
                    is_used_by_planner: True
                "refundAmount": string
                    description: "the amount refunded to the customer"
                    label: "refund amount"
                    is_displayable: True
                    is_used_by_planner: True
                "refundMethod": string
                    description: "where the refund will be issued"
                    label: "refund method"
                    is_displayable: True
                    is_used_by_planner: True
                "confirmationMessage": string
                    description: "human-readable confirmation of the cancellation"
                    label: "confirmation message"
                    is_displayable: True
                    is_used_by_planner: True

        change_flight:
            description: "Change a flight by providing the original flight info and the desired change"
            label: "Change Flight"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Requesting flight change"
            target: "flow://Skywave_ChangeFlight"

            inputs:
                "Flight": string
                    description: "The original flight that needs to be changed"
                    label: "Flight"
                    is_required: True
                    is_user_input: False
                "requested_change": string
                    description: "The requested change: route, time, or date change"
                    label: "requested_change"
                    is_required: True
                    is_user_input: False

            outputs:
                "available_options": string
                    description: "Options available based on the requested change"
                    label: "available_options"
                    filter_from_agent: False
                    is_displayable: True
                "changed_flight_information": string
                    description: "The new flight with changed information"
                    label: "changed_flight_information"
                    filter_from_agent: False
                    is_displayable: True

subagent escalation:
    label: "Escalation"
    description: "Handles requests from users who want to transfer to a live human agent."

    reasoning:
        instructions: ->
            | If a user explicitly asks to transfer to a live agent, escalate the conversation.
              If escalation fails, acknowledge the issue and ask if they would like to log a support case instead.
        actions:
            escalate_to_human: @utils.escalate
                description: "Escalate to a human agent."

subagent off_topic:
    label: "Off Topic"
    description: "Redirect conversation to relevant topics when user request goes off-topic"

    reasoning:
        instructions: ->
            | Your job is to redirect the conversation to relevant topics politely and succinctly.
              NEVER answer general knowledge questions. Only respond to general greetings and questions about your capabilities.
              Do not acknowledge the off-topic question. Redirect by asking how you can help with flight bookings or support cases.

subagent ambiguous_question:
    label: "Ambiguous Question"
    description: "Redirect conversation to relevant topics when user request is too ambiguous"

    reasoning:
        instructions: ->
            | Help the user provide clearer, more focused requests for better assistance.
              Do not answer ambiguous questions. Do not invoke any actions.
              Politely guide the user to provide more specific details about their request.

subagent seat_selection:
    label: "Seat Selection"

    description: "Helps the visitor select or change the seat on one of their bookings, rendering an interactive seat map once a single flight is resolved."

    reasoning:
        instructions: ->
            # active_bookings is already loaded by the router (get_bookings,
            # gated by retrieve_active_booking_done). Re-fetch defensively only
            # if a cold entry somehow skipped it.
            if @variables.retrieve_active_booking_done is False and @variables.resolved_contact_id != "003000000000000" and @variables.resolved_contact_id != "":
                run @actions.get_bookings
                    with contactId = @variables.resolved_contact_id
                    set @variables.active_bookings = @outputs.bookings
                    set @variables.retrieve_active_booking_error_message = @outputs.errorMessage
                    set @variables.retrieve_active_booking_done = @outputs.success

            | You help the visitor change the seat on one of their flights. The visitor is anonymous; address them as "you". Before you can show the seat map you MUST resolve the request down to exactly ONE flight (one booking, one flight on it). Use {!@variables.active_bookings} as the source of truth — never invent bookings, codes, or flight numbers.

              Follow this resolution funnel using active_bookings:
              - CASE 1 — no bookings: if the visitor has no bookings, tell them you don't see a booking to change a seat on, and offer to help book a flight instead. Do NOT call present_seat_map.
              - CASE 2 — one booking with one flight: this is already fully resolved. IMMEDIATELY call {!@actions.present_seat_map} with that booking's bookingReference and leave flightNumber blank.
              - CASE 3 — one booking with multiple flights (a connection or a return): ask which flight the seat change is for, giving a SHORT one-line summary per flight (route + date). When the visitor picks one, call {!@actions.present_seat_map} with that booking's bookingReference and the chosen flightNumber.
              - CASE 4 — more than one booking: first ask which booking, with a SHORT one-line summary per booking (route + date + how far out). After they pick a booking, apply CASE 2 / CASE 3 logic to that booking's flights before calling present_seat_map.

              When you call present_seat_map, its output is always renderable. Always use show_command to display the result to the user. You MUST present the seatMapData output to the visitor — the interactive seat-map card is contained in it and must be displayed as-is. Do NOT redraw the seat map, list seats, or describe the cabin in plain text. In your text reply alongside the card, keep it to one short sentence (e.g. "Here's the seat map — pick a seat and confirm.").

              The seat map handles everything else itself: the visitor selects a seat and taps Confirm (which changes the seat) or Abort. You will then receive one of two cues:
              - "seat change confirmed": the seat has ALREADY been changed by the card. Do NOT call any action. Simply confirm warmly in one sentence and ask if there's anything else you can help with.
              - "seat change aborted": the visitor cancelled. Do NOT call any action and do NOT retry. Acknowledge briefly and ask if there's anything else you can help with.

        actions:
            present_seat_map: @actions.present_seat_map
                description: "Render the interactive seat-map card for a single resolved flight. Call only after the funnel has narrowed to one booking + one flight. Pass the booking's confirmation code as bookingCode; pass flightNumber only when the booking has more than one flight."
                with bookingCode = ...
                with flightNumber = ...

            get_bookings: @actions.get_bookings
                with contactId = ...
                set @variables.active_bookings = @outputs.bookings
                set @variables.retrieve_active_booking_error_message = @outputs.errorMessage
                set @variables.retrieve_active_booking_done = @outputs.success

    actions:
        present_seat_map:
            description: "Returns the Skywave Seat Map renderable card for a single resolved booking segment, looked up by booking confirmation code (and optional flight number)."
            label: "Present Seat Map"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Skywave_PresentSeatMap"

            inputs:
                "bookingCode": string
                    description: "Confirmation code of the booking the visitor wants to change a seat on (from active_bookings)."
                    label: "Booking Code"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "flightNumber": string
                    description: "Flight number of the specific segment, when the booking has more than one flight. Leave blank for a single-flight booking."
                    label: "Flight Number"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "seatMapData": object
                    description: "Structured payload rendered as the Skywave Seat Map chat card."
                    label: "Seat Map Data"
                    complex_data_type_name: "c__SkywaveSeatMap"
                    filter_from_agent: True
                    is_displayable: True
                "success": boolean
                    description: "True if the seat map payload was prepared."
                    label: "success"
                    complex_data_type_name: "lightning__booleanType"
                    filter_from_agent: False
                    is_displayable: False
                "message": string
                    description: "Status detail."
                    label: "Message"
                    complex_data_type_name: "lightning__textType"
                    filter_from_agent: False
                    is_displayable: False

        get_bookings:
            description: "Gets all active flight bookings for the user"
            label: "Get Bookings"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking your flights"
            target: "apex://Skywave_GetFlightBookings"

            inputs:
                "contactId": string
                    description: "the contact Id of the user"
                    label: "contactIds"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "bookings": list[object]
                    description: "a list of bookings for the customer"
                    label: "bookings"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "@apexClassType/c__Skywave_GetFlightBookings$Booking"
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the action completed without error"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True

subagent name_change:
    label: "Name Change"

    description: "Correct or update the traveler's first or last name on a booking."

    reasoning:
        instructions: ->
            if @variables.retrieve_active_booking_done is False:
                run @actions.get_bookings
                    with contactId = @variables.resolved_contact_id
                    set @variables.active_bookings = @outputs.bookings
                    set @variables.retrieve_active_booking_error_message = @outputs.errorMessage
                    set @variables.retrieve_active_booking_done = @outputs.success

            | Help Lauren correct the first or last name on one of her bookings. The customer is already authenticated — never ask for email or identification.

            if @variables.active_bookings is None:
                | Lauren currently has no bookings to update. Let her know and offer to help with something else.

            if @variables.active_bookings is not None:
                | Here are Lauren's current bookings: {!@variables.active_bookings}
                  If she has more than one booking, ask which booking the name change is for using a SHORT one-line summary per booking (trip type, origin/destination, how far out).
                  Ask for the corrected first name and last name, then confirm the change with her before calling the action.
                  When she confirms, call {!@actions.change_name} with the booking's bookingReference, the new firstName, and the new lastName.
                  After the action returns, relay the confirmationMessage to the user using its exact values — do NOT paraphrase.

        actions:
            change_name: @actions.change_name
                with bookingReference = ...
                with firstName = ...
                with lastName = ...
                with contactId = @variables.resolved_contact_id

            get_bookings: @actions.get_bookings
                with contactId = ...
                set @variables.active_bookings = @outputs.bookings
                set @variables.retrieve_active_booking_error_message = @outputs.errorMessage
                set @variables.retrieve_active_booking_done = @outputs.success

    actions:
        change_name:
            description: "Updates the traveler's first and last name on a booking"
            label: "Change Name on Booking"
            require_user_confirmation: True
            include_in_progress_indicator: True
            progress_indicator_message: "Updating name on booking"
            target: "apex://Skywave_ChangeName"

            inputs:
                "bookingReference": string
                    description: "The booking reference (confirmation code) for the booking to update"
                    label: "Booking Reference"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "firstName": string
                    description: "The corrected first name for the traveler"
                    label: "First Name"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"
                "lastName": string
                    description: "The corrected last name for the traveler"
                    label: "Last Name"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"
                "contactId": string
                    description: "The contact ID associated with the booking"
                    label: "Contact ID"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "success": boolean
                    description: "true if the name change was processed"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "bookingReference": string
                    description: "the booking reference that was updated"
                    label: "booking reference"
                    is_displayable: True
                    is_used_by_planner: True
                "updatedFirstName": string
                    description: "the new first name on the booking"
                    label: "updated first name"
                    is_displayable: True
                    is_used_by_planner: True
                "updatedLastName": string
                    description: "the new last name on the booking"
                    label: "updated last name"
                    is_displayable: True
                    is_used_by_planner: True
                "confirmationMessage": string
                    description: "human-readable confirmation of the name change"
                    label: "confirmation message"
                    is_displayable: True
                    is_used_by_planner: True

        get_bookings:
            description: "Gets all active flight bookings for the user"
            label: "Get Bookings"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking your flights"
            target: "apex://Skywave_GetFlightBookings"

            inputs:
                "contactId": string
                    description: "the contact Id of the user"
                    label: "contactIds"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "bookings": list[object]
                    description: "a list of bookings for the customer"
                    label: "bookings"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "@apexClassType/c__Skywave_GetFlightBookings$Booking"
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the action completed without error"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True

subagent mileage_account:
    label: "Mileage Account"

    description: "Provides the customer's mileage / tier points / loyalty points balance."

    reasoning:
        instructions: ->
            if @variables.mileage_balance is None:
                run @actions.get_mileage_balance
                    with contactId = @variables.resolved_contact_id
                    set @variables.mileage_balance = @outputs.milesBalance
                    set @variables.mileage_balance_message = @outputs.confirmationMessage

            | Tell Lauren her current mileage balance using the exact number from mileage_balance. Do NOT paraphrase or round the number.
              Use the confirmation message as the primary response: {!@variables.mileage_balance_message}
              Then ask if there is anything else you can help with.

    actions:
        get_mileage_balance:
            description: "Gets the customer's current mileage / tier points / loyalty points balance"
            label: "Get Mileage Balance"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking your mileage balance"
            target: "apex://Skywave_GetMileageBalance"

            inputs:
                "contactId": string
                    description: "The contact ID for the customer"
                    label: "Contact ID"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "success": boolean
                    description: "true if the action completed without error"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "milesBalance": object
                    description: "the customer's current mileage balance"
                    label: "miles balance"
                    complex_data_type_name: "lightning__integerType"
                    is_displayable: True
                    is_used_by_planner: True
                "confirmationMessage": string
                    description: "human-readable summary of the mileage balance"
                    label: "confirmation message"
                    is_displayable: True
                    is_used_by_planner: True

subagent case_management:
    label: "Case Management"

    description: "Handles customer inquiries and actions related to support cases, including providing case information, updating existing cases, and creating new cases."

    reasoning:
        instructions: ->
            | Always format dates in a human readable format.
              Do not show Case Id to the customer.
              If the customer is not known, ask for their email address and get their Contact record first.
              When adding a comment, first retrieve the case details, ask for the exact comment, then add it.
              When sharing case details, show: Case number, Subject, Description, and Status as an itemized list.
              When a customer asks to create a case, summarize the conversation. Subject should be under 7 words. Description should be no more than 3 sentences.
              Acknowledge and validate user concerns with empathy and professionalism.

        actions:
            create_case: @actions.create_case
                with verifiedCustomerID = ...
                with messagingSessionID = ...
                with caseSubject = ...
                with caseDescription = ...

            get_cases_for_contact: @actions.get_cases_for_contact
                with verifiedContactID = ...

            get_case_by_number: @actions.get_case_by_number
                with caseNumber = ...
                with customerEmail = ...

            add_case_comment: @actions.add_case_comment
                with caseRecord = ...
                with caseComment = ...

    actions:
        create_case:
            description: "Creates a support case for the customer"
            label: "Create Case"
            require_user_confirmation: True
            include_in_progress_indicator: True
            target: "flow://Skywave_CreateCase"

            inputs:
                "verifiedCustomerID": string
                    description: "The contact ID for the case"
                    label: "Verified Customer ID"
                    is_required: True
                    is_user_input: False
                "messagingSessionID": string
                    description: "The messaging session ID"
                    label: "Messaging Session ID"
                    is_required: False
                    is_user_input: False
                "caseSubject": string
                    description: "The subject of the case"
                    label: "Case Subject"
                    is_required: False
                    is_user_input: True
                "caseDescription": string
                    description: "The description of the case"
                    label: "Case Description"
                    is_required: False
                    is_user_input: True

            outputs:
                "caseRecord": object
                    description: "The created case record"
                    label: "Case record"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__recordInfoType"

        get_cases_for_contact:
            description: "Returns a list of cases for a given contact ID"
            label: "Get Cases for Contact"
            require_user_confirmation: False
            include_in_progress_indicator: True
            target: "flow://Skywave_GetCasesForContact"

            inputs:
                "verifiedContactID": string
                    description: "The contact record ID"
                    label: "Verified Contact record ID"
                    is_required: True
                    is_user_input: False

            outputs:
                "caseList": list[object]
                    description: "Cases for the contact"
                    label: "Case List"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__recordInfoType"

        get_case_by_number:
            description: "Returns a case by email and case number"
            label: "Get Case by Number"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking Status"
            target: "flow://Skywave_GetCaseByNumber"

            inputs:
                "caseNumber": string
                    description: "case number"
                    label: "caseNumber"
                    is_required: False
                    complex_data_type_name: "lightning__textType"
                "customerEmail": string
                    description: "contact email"
                    label: "customerEmail"
                    is_required: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "caseRecord": object
                    description: "the case record"
                    label: "caseRecord"
                    complex_data_type_name: "lightning__recordInfoType"
                    filter_from_agent: False
                    is_displayable: True

        add_case_comment:
            description: "Adds a comment to an existing case"
            label: "Add Case Comment"
            require_user_confirmation: True
            include_in_progress_indicator: True
            target: "flow://Skywave_AddCaseComment"

            inputs:
                "caseRecord": object
                    description: "The case record to add the comment to"
                    label: "Case record"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__recordInfoType"
                "caseComment": string
                    description: "The comment text"
                    label: "Case comment"
                    is_required: True
                    is_user_input: True

            outputs:
                "outcomeMessage": string
                    description: "Result message"
                    label: "Outcome message"
                    is_displayable: True
                    filter_from_agent: False

connection customer_web_client:
    adaptive_response_allowed: True
    outbound_route_name: "flow://Route_from_ASA"
    outbound_route_type: "OmniChannelFlow"
    escalation_message: "escalating"

modality voice:
    voice_id: "UgBBYS2sOqTuMpoF3BR0"
    outbound_speed: 1.0
    outbound_stability: 0.65
    outbound_similarity: 0.75
