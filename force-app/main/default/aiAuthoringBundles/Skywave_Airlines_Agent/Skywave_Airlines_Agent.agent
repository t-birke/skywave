system:
  instructions: "You are a support agent for Skywave Airlines. Greet the visitor and assist with their flight bookings and related inquiries."

  messages:
    welcome: |
        Hi! I'm the Skywave Airlines AI agent. Your conversation id is: {!@variables.Conversation_Id}. How can I help?
    error: "Something went wrong, please try again."

config:
    developer_name: "Skywave_Airlines_Agent"
    agent_label: "Skywave Airlines Agent"
    description: "A support agent for Skywave Airlines that assists customers with their flight bookings and related inquiries."
    agent_type: "AgentforceServiceAgent"
    default_agent_user: "skywaveserviceagent@example.com"

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "MessagingEndUser Id"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "MessagingSession Id"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "MessagingEndUser ContactId"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "MessagingSession EndUserLanguage"
    Conversation_Id: linked string
        source: @MessagingSession.ConversationId
        description: "Join key for Skywave_ResolveSession to look up the visitor's anonymous Contact (with survey answers)."
    survey_summary: mutable string
        label: "Survey Summary"
        description: "Natural-language summary of the visitor's survey answers (favourite destination, cabin class, etc.) keyed off Session_ID."
    survey_responses_json: mutable string
        label: "Survey Responses (JSON)"
        description: "Structured JSON map of question_key → {questionText, answerText, answerKey} for fine-grained reasoning."
    survey_resolved: mutable boolean = False
        label: "Survey Resolved"
        description: "True once Skywave_ResolveSession has run for this conversation."
    VerifiedCustomerId: mutable string
        description: "Verified customer contact ID"
    Latest_Flight_Search_Results: mutable object
        label: "Latest Flight Search Results"
    flight_booking_detail: mutable object
        label: "Flight Booking Detail"
    flight_booking_error_detail: mutable string
        label: "Flight Booking Error Detail"
    flight_booking_error_flag: mutable boolean
        label: "Flight Booking Error Flag"
    check_imminent_flights_success: mutable boolean = False
        label: "Check Imminent Flights Success"
    check_imminent_flight_error_message: mutable string
        label: "Check Imminent Flight Error Message"
    flights_within_72hrs: mutable number = 0
        label: "Flights Within 72hrs"
    active_bookings: mutable object
        label: "Active Bookings"
    retrieve_active_booking_error_message: mutable string
        label: "Retrieve Active Booking Error Message"
    retrieve_active_booking_done: mutable boolean = False
        label: "Retrieve Active Booking Done"
    Tier_Status: mutable string
        label: "Tier Status"
    mileage_balance: mutable number
        label: "Mileage Balance"
    mileage_balance_message: mutable string
        label: "Mileage Balance Message"
    booking: mutable string
        label: "Booking"
    Booking_Outcome: mutable boolean
        label: "Booking Outcome"
    resolved_contact_id: mutable string = "003000000000000"
        description: "Resolved contact ID for the current user (demo: pre-authenticated as Lauren)"

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

knowledge:
    citations_enabled: False

start_agent agent_router:
    label: "Agent Router"

    description: "Welcome the user and determine the appropriate subagent based on user input"
    
    reasoning:
        instructions: ->
            if @variables.ContactId is not None and @variables.resolved_contact_id == "":
                run @actions.resolve_contact
                    with contactId = @variables.ContactId
                    set @variables.resolved_contact_id = @outputs.contactId

            if @variables.resolved_contact_id != "" and @variables.check_imminent_flights_success == False:
                run @actions.get_upcoming_flights
                    with contactId = @variables.resolved_contact_id
                    set @variables.check_imminent_flight_error_message = @outputs.errorMessage
                    set @variables.flights_within_72hrs = @outputs.imminentFlights
                    set @variables.check_imminent_flights_success = @outputs.success

            | You are a router only. Do NOT answer questions or provide help directly.
              Always use a transition action to route to the correct topic immediately.
              - Flight bookings, upcoming flights, flight status, booking a flight, changing or canceling flights -> use go_to_flight_management
              - Seat selection or seat changes for a flight within 72 hours -> use go_to_seat_selection
              - Correcting or updating the traveler's first or last name on a booking -> use go_to_name_change
              - Questions about mileage balance, tier points, loyalty points, or frequent flyer miles -> use go_to_mileage_account
              - Support cases, complaints, case status, creating a case -> use go_to_case_management
              - Request to speak to a human agent or live agent -> use go_to_escalation
              - Ambiguous or unclear requests -> use go_to_ambiguous_question
              - Off-topic or unrelated questions -> use go_to_off_topic
              Never attempt to help the customer yourself. Always route.

        actions:
            go_to_flight_management: @utils.transition to @subagent.flight_management
                description: "Route to flight management for booking, viewing, changing, or canceling flights"

            go_to_escalation: @utils.transition to @subagent.escalation
                description: "Transfer to a live human agent"

            go_to_off_topic: @utils.transition to @subagent.off_topic
                description: "Handle off-topic or unrelated questions"

            go_to_ambiguous_question: @utils.transition to @subagent.ambiguous_question
                description: "Handle unclear or ambiguous requests that need clarification"

            go_to_seat_selection: @utils.transition to @subagent.seat_selection
                description: "Select or change seats for a flight departing within 72 hours"
                available when @variables.flights_within_72hrs > 0

            go_to_case_management: @utils.transition to @subagent.case_management
                description: "Create, view, or update support cases"

            go_to_name_change: @utils.transition to @subagent.name_change
                description: "Correct or update the traveler's first or last name on a booking"

            go_to_mileage_account: @utils.transition to @subagent.mileage_account
                description: "Check mileage balance, tier points, loyalty points, or frequent flyer miles"

    actions:
        resolve_contact:
            description: "Resolves a Contact ID from a known ID or email lookup"
            label: "Resolve Contact"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Skywave_ResolveContact"

            inputs:
                "contactId": string
                    description: "A known Contact ID to validate"
                    label: "Contact ID"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "email": string
                    description: "Email address to look up a Contact"
                    label: "Email"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "contactId": string
                    description: "The resolved Contact ID"
                    label: "Contact ID"
                    is_displayable: False
                    is_used_by_planner: True
                "contactName": string
                    description: "The contact name"
                    label: "Contact Name"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the contact was resolved"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True
                "errorMessage": string
                    description: "Error details"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True

        get_upcoming_flights:
            description: "Gets upcoming flights for the user within the next 72 hours"
            label: "Get Upcoming Flights"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Skywave_GetUpcomingFlights"

            inputs:
                "contactId": string
                    description: "The contact id for the customer"
                    label: "contactId"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "imminentFlights": object
                    description: "flights within the next 72 hours"
                    label: "imminent flights"
                    complex_data_type_name: "lightning__integerType"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the action completed without error"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True

subagent flight_management:
    label: "Flight Management"

    description: "Assist users with booking, canceling, or changing flights, including checking if they have flights within the next 72 hours."

    reasoning:
        instructions: ->
            if @variables.survey_resolved is False:
                run @actions.resolve_session
                    with conversationId = @variables.Conversation_Id
                    set @variables.survey_summary = @outputs.summary
                    set @variables.survey_responses_json = @outputs.responsesJson
                    set @variables.survey_resolved = True

            if @variables.retrieve_active_booking_done is False and @variables.resolved_contact_id != "003000000000000" and @variables.resolved_contact_id != "":
                run @actions.get_bookings
                    with contactId = @variables.resolved_contact_id
                    set @variables.active_bookings = @outputs.bookings
                    set @variables.retrieve_active_booking_error_message = @outputs.errorMessage
                    set @variables.retrieve_active_booking_done = @outputs.success

            | Assist Lauren with her flight bookings. The customer is already authenticated — never ask for email or identification.

            if @variables.survey_summary is not None and @variables.survey_summary != "":
                | Before this conversation, the visitor answered a short travel-preferences survey. {!@variables.survey_summary}
                  Use these declared preferences to make your suggestions more personal — for example, lean toward their stated favourite destination when offering flights, propose their preferred cabin class without asking, and respect their seat preference. Do NOT enumerate the survey answers back to the user; weave them in naturally.

            if @variables.active_bookings is None:
                | Lauren currently has no flights booked. Let her know and offer to search for flights.

            if @variables.active_bookings is not None:
                | Here are Lauren's current bookings: {!@variables.active_bookings}
                  When the user asks about her bookings, give a SHORT one-line summary per booking — trip type (one-way vs return), origin and destination cities, and how far out it is (e.g., "in 3 days", "in about 2 months"). Then ask which booking she means. Do NOT dump every field unless asked.
                  When presenting full details, use the exact values returned — do NOT paraphrase or round. Do NOT use the show_command tool. Always compose your response as direct text.

            | If the user wants to CANCEL a booking, identify which booking from active_bookings, then state the booking's cancellationConditions in plain language and ask her to confirm. Once she confirms, call {!@actions.cancel_booking} with the booking's bookingReference. After the action returns, relay the confirmationMessage to the user using its exact values (refund amount, payment method) — do NOT paraphrase the numbers.
              If the user wants to change a seat, use the {!@actions.change_seat} action.
              If the user wants to book a new flight or reschedule, use {!@actions.Reschedule_Flights} to find available options and check eligibility.
              If the user wants to search for flights, use {!@actions.search_flights} with origin, destination, and departure date.
              If the user has confirmed specific flight details from search results (flightId, travelDate, fareClass), use {!@actions.book_flight} with all required parameters.
              After calling any action, present the results in your text response using exact values. Do NOT call the same action again unless the user asks for a new search or change.

        actions:
            resolve_session: @actions.resolve_session
                description: "Look up the visitor's declared survey answers from the anonymous Contact created at survey-complete time, keyed by the chat conversationId. Runs once at the start of flight management; outputs are cached in @variables.survey_summary and @variables.survey_responses_json."
                with conversationId = ...

            identify_customer: @actions.resolve_contact
                description: "Look up a customer by their email address to identify them"
                available when @variables.resolved_contact_id == ""
                with email = ...
                set @variables.resolved_contact_id = @outputs.contactId

            Reschedule_Flights: @actions.Reschedule_Flights
                with "Input:New_Flight_Requested" = ...

            search_flights: @actions.search_flights
                with departureDate = ...
                with destination = ...
                with origin = ...
                set @variables.Latest_Flight_Search_Results = @outputs.options

            book_flight: @actions.book_flight
                with contactId = @variables.resolved_contact_id
                with flightId = ...
                with travelDate = ...
                with fareClass = ...
                with checkedBags = ...
                with seatPreference = ...
                set @variables.flight_booking_detail = @outputs.booking
                set @variables.flight_booking_error_detail = @outputs.errorMessage
                set @variables.flight_booking_error_flag = @outputs.success

            get_bookings: @actions.get_bookings
                with contactId = ...
                set @variables.active_bookings = @outputs.bookings
                set @variables.retrieve_active_booking_error_message = @outputs.errorMessage
                set @variables.retrieve_active_booking_done = @outputs.success

            change_seat: @actions.change_seat
                with reservationSegmentId = ...
                with newSeatNumber = ...
                with seatPreference = ...

            cancel_booking: @actions.cancel_booking
                with bookingReference = ...
                with contactId = @variables.resolved_contact_id

            change_flight: @actions.change_flight
                with Flight = ...
                with requested_change = ...

    actions:
        resolve_session:
            description: "Resolves the visitor's MessagingSession.ConversationId to their declared survey answers, by querying the anonymous Contact created at survey-complete time. Returns a natural-language summary plus a JSON map of question_key → {questionText, answerText, answerKey}."
            label: "Resolve Session Context"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Skywave_ResolveSession"

            inputs:
                "conversationId": string
                    description: "The MessagingSession.ConversationId, sourced from the @MessagingSession.ConversationId linked variable."
                    label: "Conversation Id"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "answerCount": number
                    description: "How many distinct survey questions the visitor has answered."
                    label: "Answer Count"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__numberType"
                "responsesJson": string
                    description: "JSON map of question_key → {questionText, answerText, answerKey} for fine-grained reasoning."
                    label: "Survey Responses (JSON)"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"
                "summary": string
                    description: "One-line natural-language summary of the visitor's declared preferences. Intended for direct use in agent reasoning."
                    label: "Summary"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "lightning__textType"

        Reschedule_Flights:
            description: "Reschedule flights based on user tier and reservation booking type"
            label: "Reschedule Flights"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "generatePromptResponse://Skywave_RescheduleFlights"

            inputs:
                "Input:New_Flight_Requested": string
                    description: "requested flight"
                    label: "New Flight Requested"
                    is_required: True
                    complex_data_type_name: "lightning__textType"

            outputs:
                "promptResponse": string
                    description: "The prompt response generated by the action based on the specified prompt and input."
                    label: "Prompt Response"
                    complex_data_type_name: "lightning__textType"
                    filter_from_agent: False
                    is_displayable: True

        search_flights:
            description: "Searches available flight itineraries"
            label: "Search Flights"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Looking for available flights"
            target: "apex://Skywave_FlightSearch"

            inputs:
                "departureDate": string
                    description: "The desired departure date formatted in YYYY-MM-DD"
                    label: "Departure Date (YYYY-MM-DD)"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"
                "destination": string
                    description: "The destination Airport Code in 3-Letter IATA format"
                    label: "Destination Airport Code (IATA)"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "origin": string
                    description: "The origin Airport Code in 3-Letter IATA format"
                    label: "Origin Airport Code (IATA)"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "options": list[object]
                    description: "A list of available flight options and details"
                    label: "Flight Options"
                    is_displayable: True
                    is_used_by_planner: True
                    complex_data_type_name: "@apexClassType/c__Skywave_FlightSearch$FlightOption"

        book_flight:
            description: "Books a flight. Requires contactId, flightId from search results, travel date, and fare class."
            label: "Book Flight"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Processing booking"
            target: "apex://Skywave_BookFlight"

            inputs:
                "contactId": string
                    description: "The contact ID for the booking"
                    label: "Contact ID"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "flightId": string
                    description: "The Flight__c record ID to book (from search results)"
                    label: "Flight ID"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "travelDate": string
                    description: "Date of travel (YYYY-MM-DD)"
                    label: "Travel Date"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "fareClass": string
                    description: "Fare class: Basic, Choice, Choice Preferred, or Choice Extra"
                    label: "Fare Class"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "checkedBags": object
                    description: "Number of checked bags"
                    label: "Checked Bags"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__integerType"
                "seatPreference": string
                    description: "Seat preference (e.g., Window, Aisle)"
                    label: "Seat Preference"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "booking": object
                    description: "The flight booking details"
                    label: "bookingCode"
                    is_displayable: True
                    is_used_by_planner: True
                    complex_data_type_name: "@apexClassType/c__Skywave_BookFlight$Booking"
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the action completed without error"
                    label: "success"
                    is_displayable: True
                    is_used_by_planner: True

        resolve_contact:
            description: "Resolves a Contact ID from a known ID or email lookup"
            label: "Resolve Contact"
            require_user_confirmation: False
            include_in_progress_indicator: False
            target: "apex://Skywave_ResolveContact"

            inputs:
                "contactId": string
                    description: "A known Contact ID to validate"
                    label: "Contact ID"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "email": string
                    description: "Email address to look up a Contact"
                    label: "Email"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "contactId": string
                    description: "The resolved Contact ID"
                    label: "Contact ID"
                    is_displayable: False
                    is_used_by_planner: True
                "contactName": string
                    description: "The contact name"
                    label: "Contact Name"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the contact was resolved"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True
                "errorMessage": string
                    description: "Error details"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True

        get_bookings:
            description: "Gets all active flight bookings for the user"
            label: "Get Bookings"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking your flights"
            target: "apex://Skywave_GetFlightBookings"

            inputs:
                "contactId": string
                    description: "the contact Id of the user"
                    label: "contactIds"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "bookings": list[object]
                    description: "a list of bookings for the customer"
                    label: "bookings"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "@apexClassType/c__Skywave_GetFlightBookings$Booking"
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the action completed without error"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True

        change_seat:
            description: "Change seat selection for a flight reservation segment"
            label: "Change Seat"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Changing seat assignment"
            target: "apex://Skywave_ChangeSeat"

            inputs:
                "reservationSegmentId": string
                    description: "The Reservation Segment ID to change seat for"
                    label: "Reservation Segment ID"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "newSeatNumber": string
                    description: "The desired seat number (e.g., 12A)"
                    label: "New Seat Number"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "seatPreference": string
                    description: "Seat preference if no specific seat: Window, Aisle, or Middle"
                    label: "Seat Preference"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    complex_data_type_name: "lightning__textType"
                    is_used_by_planner: True
                    is_displayable: False
                "success": boolean
                    description: "true if the action completed without error"
                    label: "success"
                    complex_data_type_name: "lightning__booleanType"
                    is_used_by_planner: True
                    is_displayable: False
                "updatedSegment": object
                    description: "Information about the seat change"
                    label: "updated segment"
                    complex_data_type_name: "@apexClassType/c__Skywave_ChangeSeat$SegmentInfo"
                    is_used_by_planner: True
                    is_displayable: True

        cancel_booking:
            description: "Cancels a flight booking and processes the refund"
            label: "Cancel Booking"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Processing cancellation"
            target: "apex://Skywave_CancelFlight"

            inputs:
                "bookingReference": string
                    description: "The booking reference of the booking to cancel"
                    label: "Booking Reference"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "contactId": string
                    description: "The contact ID associated with the booking"
                    label: "Contact ID"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "success": boolean
                    description: "true if the cancellation was processed"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "bookingReference": string
                    description: "the cancelled booking reference"
                    label: "booking reference"
                    is_displayable: True
                    is_used_by_planner: True
                "cancellationFee": string
                    description: "the fee applied for cancelling the booking"
                    label: "cancellation fee"
                    is_displayable: True
                    is_used_by_planner: True
                "refundAmount": string
                    description: "the amount refunded to the customer"
                    label: "refund amount"
                    is_displayable: True
                    is_used_by_planner: True
                "refundMethod": string
                    description: "where the refund will be issued"
                    label: "refund method"
                    is_displayable: True
                    is_used_by_planner: True
                "confirmationMessage": string
                    description: "human-readable confirmation of the cancellation"
                    label: "confirmation message"
                    is_displayable: True
                    is_used_by_planner: True

        change_flight:
            description: "Change a flight by providing the original flight info and the desired change"
            label: "Change Flight"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Requesting flight change"
            target: "flow://Skywave_ChangeFlight"

            inputs:
                "Flight": string
                    description: "The original flight that needs to be changed"
                    label: "Flight"
                    is_required: True
                    is_user_input: False
                "requested_change": string
                    description: "The requested change: route, time, or date change"
                    label: "requested_change"
                    is_required: True
                    is_user_input: False

            outputs:
                "available_options": string
                    description: "Options available based on the requested change"
                    label: "available_options"
                    filter_from_agent: False
                    is_displayable: True
                "changed_flight_information": string
                    description: "The new flight with changed information"
                    label: "changed_flight_information"
                    filter_from_agent: False
                    is_displayable: True

subagent escalation:
    label: "Escalation"
    description: "Handles requests from users who want to transfer to a live human agent."

    reasoning:
        instructions: ->
            | If a user explicitly asks to transfer to a live agent, escalate the conversation.
              If escalation fails, acknowledge the issue and ask if they would like to log a support case instead.
        actions:
            escalate_to_human: @utils.escalate
                description: "Escalate to a human agent."

subagent off_topic:
    label: "Off Topic"
    description: "Redirect conversation to relevant topics when user request goes off-topic"

    reasoning:
        instructions: ->
            | Your job is to redirect the conversation to relevant topics politely and succinctly.
              NEVER answer general knowledge questions. Only respond to general greetings and questions about your capabilities.
              Do not acknowledge the off-topic question. Redirect by asking how you can help with flight bookings or support cases.

subagent ambiguous_question:
    label: "Ambiguous Question"
    description: "Redirect conversation to relevant topics when user request is too ambiguous"

    reasoning:
        instructions: ->
            | Help the user provide clearer, more focused requests for better assistance.
              Do not answer ambiguous questions. Do not invoke any actions.
              Politely guide the user to provide more specific details about their request.

subagent seat_selection:
    label: "Seat Selection"

    description: "Helps users select or change seats on their flights"

    reasoning:
        instructions: ->
            | Help the customer book a seat on their flight based on the plane model and seats available.
              For upgraded seat options, check the loyalty tier status.
              If the user has a preferred seat, suggest it if available.

        actions:
            change_seat: @actions.change_seat
                with reservationSegmentId = ...
                with newSeatNumber = ...
                with seatPreference = ...
                set @variables.flight_booking_error_detail = @outputs.errorMessage
                set @variables.Booking_Outcome = @outputs.success

    actions:
        change_seat:
            description: "Change seat selection for a flight reservation segment"
            label: "Change Seat"
            target: "apex://Skywave_ChangeSeat"

            inputs:
                reservationSegmentId: string
                    description: "The Reservation Segment ID to change seat for"
                    label: "Reservation Segment ID"
                    is_required: True
                    complex_data_type_name: "lightning__textType"
                newSeatNumber: string
                    description: "The desired seat number (e.g., 12A)"
                    label: "New Seat Number"
                    is_required: False
                    complex_data_type_name: "lightning__textType"
                seatPreference: string
                    description: "Seat preference if no specific seat: Window, Aisle, or Middle"
                    label: "Seat Preference"
                    is_required: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                errorMessage: string
                    description: "details in case of an error"
                    label: "error message"
                    complex_data_type_name: "lightning__textType"
                    is_used_by_planner: True
                    is_displayable: False
                success: boolean
                    description: "true if the action completed without error"
                    label: "success"
                    complex_data_type_name: "lightning__booleanType"
                    is_used_by_planner: True
                    is_displayable: False
                updatedSegment: object
                    description: "Information about the seat change"
                    label: "updated segment"
                    complex_data_type_name: "@apexClassType/c__Skywave_ChangeSeat$SegmentInfo"
                    is_used_by_planner: True
                    is_displayable: True

subagent name_change:
    label: "Name Change"

    description: "Correct or update the traveler's first or last name on a booking."

    reasoning:
        instructions: ->
            if @variables.retrieve_active_booking_done is False:
                run @actions.get_bookings
                    with contactId = @variables.resolved_contact_id
                    set @variables.active_bookings = @outputs.bookings
                    set @variables.retrieve_active_booking_error_message = @outputs.errorMessage
                    set @variables.retrieve_active_booking_done = @outputs.success

            | Help Lauren correct the first or last name on one of her bookings. The customer is already authenticated — never ask for email or identification.

            if @variables.active_bookings is None:
                | Lauren currently has no bookings to update. Let her know and offer to help with something else.

            if @variables.active_bookings is not None:
                | Here are Lauren's current bookings: {!@variables.active_bookings}
                  If she has more than one booking, ask which booking the name change is for using a SHORT one-line summary per booking (trip type, origin/destination, how far out).
                  Ask for the corrected first name and last name, then confirm the change with her before calling the action.
                  When she confirms, call {!@actions.change_name} with the booking's bookingReference, the new firstName, and the new lastName.
                  After the action returns, relay the confirmationMessage to the user using its exact values — do NOT paraphrase.

        actions:
            change_name: @actions.change_name
                with bookingReference = ...
                with firstName = ...
                with lastName = ...
                with contactId = @variables.resolved_contact_id

            get_bookings: @actions.get_bookings
                with contactId = ...
                set @variables.active_bookings = @outputs.bookings
                set @variables.retrieve_active_booking_error_message = @outputs.errorMessage
                set @variables.retrieve_active_booking_done = @outputs.success

    actions:
        change_name:
            description: "Updates the traveler's first and last name on a booking"
            label: "Change Name on Booking"
            require_user_confirmation: True
            include_in_progress_indicator: True
            progress_indicator_message: "Updating name on booking"
            target: "apex://Skywave_ChangeName"

            inputs:
                "bookingReference": string
                    description: "The booking reference (confirmation code) for the booking to update"
                    label: "Booking Reference"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"
                "firstName": string
                    description: "The corrected first name for the traveler"
                    label: "First Name"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"
                "lastName": string
                    description: "The corrected last name for the traveler"
                    label: "Last Name"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"
                "contactId": string
                    description: "The contact ID associated with the booking"
                    label: "Contact ID"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "success": boolean
                    description: "true if the name change was processed"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "bookingReference": string
                    description: "the booking reference that was updated"
                    label: "booking reference"
                    is_displayable: True
                    is_used_by_planner: True
                "updatedFirstName": string
                    description: "the new first name on the booking"
                    label: "updated first name"
                    is_displayable: True
                    is_used_by_planner: True
                "updatedLastName": string
                    description: "the new last name on the booking"
                    label: "updated last name"
                    is_displayable: True
                    is_used_by_planner: True
                "confirmationMessage": string
                    description: "human-readable confirmation of the name change"
                    label: "confirmation message"
                    is_displayable: True
                    is_used_by_planner: True

        get_bookings:
            description: "Gets all active flight bookings for the user"
            label: "Get Bookings"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking your flights"
            target: "apex://Skywave_GetFlightBookings"

            inputs:
                "contactId": string
                    description: "the contact Id of the user"
                    label: "contactIds"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "bookings": list[object]
                    description: "a list of bookings for the customer"
                    label: "bookings"
                    is_displayable: False
                    is_used_by_planner: True
                    complex_data_type_name: "@apexClassType/c__Skywave_GetFlightBookings$Booking"
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "success": boolean
                    description: "true if the action completed without error"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True

subagent mileage_account:
    label: "Mileage Account"

    description: "Provides the customer's mileage / tier points / loyalty points balance."

    reasoning:
        instructions: ->
            if @variables.mileage_balance is None:
                run @actions.get_mileage_balance
                    with contactId = @variables.resolved_contact_id
                    set @variables.mileage_balance = @outputs.milesBalance
                    set @variables.mileage_balance_message = @outputs.confirmationMessage

            | Tell Lauren her current mileage balance using the exact number from mileage_balance. Do NOT paraphrase or round the number.
              Use the confirmation message as the primary response: {!@variables.mileage_balance_message}
              Then ask if there is anything else you can help with.

    actions:
        get_mileage_balance:
            description: "Gets the customer's current mileage / tier points / loyalty points balance"
            label: "Get Mileage Balance"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking your mileage balance"
            target: "apex://Skywave_GetMileageBalance"

            inputs:
                "contactId": string
                    description: "The contact ID for the customer"
                    label: "Contact ID"
                    is_required: False
                    is_user_input: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "success": boolean
                    description: "true if the action completed without error"
                    label: "success"
                    is_displayable: False
                    is_used_by_planner: True
                "errorMessage": string
                    description: "details in case of an error"
                    label: "error message"
                    is_displayable: False
                    is_used_by_planner: True
                "milesBalance": object
                    description: "the customer's current mileage balance"
                    label: "miles balance"
                    complex_data_type_name: "lightning__integerType"
                    is_displayable: True
                    is_used_by_planner: True
                "confirmationMessage": string
                    description: "human-readable summary of the mileage balance"
                    label: "confirmation message"
                    is_displayable: True
                    is_used_by_planner: True

subagent case_management:
    label: "Case Management"

    description: "Handles customer inquiries and actions related to support cases, including providing case information, updating existing cases, and creating new cases."

    reasoning:
        instructions: ->
            | Always format dates in a human readable format.
              Do not show Case Id to the customer.
              If the customer is not known, ask for their email address and get their Contact record first.
              When adding a comment, first retrieve the case details, ask for the exact comment, then add it.
              When sharing case details, show: Case number, Subject, Description, and Status as an itemized list.
              When a customer asks to create a case, summarize the conversation. Subject should be under 7 words. Description should be no more than 3 sentences.
              Acknowledge and validate user concerns with empathy and professionalism.

        actions:
            create_case: @actions.create_case
                with verifiedCustomerID = ...
                with messagingSessionID = ...
                with caseSubject = ...
                with caseDescription = ...

            get_cases_for_contact: @actions.get_cases_for_contact
                with verifiedContactID = ...

            get_case_by_number: @actions.get_case_by_number
                with caseNumber = ...
                with customerEmail = ...

            add_case_comment: @actions.add_case_comment
                with caseRecord = ...
                with caseComment = ...

    actions:
        create_case:
            description: "Creates a support case for the customer"
            label: "Create Case"
            require_user_confirmation: True
            include_in_progress_indicator: True
            target: "flow://Skywave_CreateCase"

            inputs:
                "verifiedCustomerID": string
                    description: "The contact ID for the case"
                    label: "Verified Customer ID"
                    is_required: True
                    is_user_input: False
                "messagingSessionID": string
                    description: "The messaging session ID"
                    label: "Messaging Session ID"
                    is_required: False
                    is_user_input: False
                "caseSubject": string
                    description: "The subject of the case"
                    label: "Case Subject"
                    is_required: False
                    is_user_input: True
                "caseDescription": string
                    description: "The description of the case"
                    label: "Case Description"
                    is_required: False
                    is_user_input: True

            outputs:
                "caseRecord": object
                    description: "The created case record"
                    label: "Case record"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__recordInfoType"

        get_cases_for_contact:
            description: "Returns a list of cases for a given contact ID"
            label: "Get Cases for Contact"
            require_user_confirmation: False
            include_in_progress_indicator: True
            target: "flow://Skywave_GetCasesForContact"

            inputs:
                "verifiedContactID": string
                    description: "The contact record ID"
                    label: "Verified Contact record ID"
                    is_required: True
                    is_user_input: False

            outputs:
                "caseList": list[object]
                    description: "Cases for the contact"
                    label: "Case List"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__recordInfoType"

        get_case_by_number:
            description: "Returns a case by email and case number"
            label: "Get Case by Number"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking Status"
            target: "flow://Skywave_GetCaseByNumber"

            inputs:
                "caseNumber": string
                    description: "case number"
                    label: "caseNumber"
                    is_required: False
                    complex_data_type_name: "lightning__textType"
                "customerEmail": string
                    description: "contact email"
                    label: "customerEmail"
                    is_required: False
                    complex_data_type_name: "lightning__textType"

            outputs:
                "caseRecord": object
                    description: "the case record"
                    label: "caseRecord"
                    complex_data_type_name: "lightning__recordInfoType"
                    filter_from_agent: False
                    is_displayable: True

        add_case_comment:
            description: "Adds a comment to an existing case"
            label: "Add Case Comment"
            require_user_confirmation: True
            include_in_progress_indicator: True
            target: "flow://Skywave_AddCaseComment"

            inputs:
                "caseRecord": object
                    description: "The case record to add the comment to"
                    label: "Case record"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__recordInfoType"
                "caseComment": string
                    description: "The comment text"
                    label: "Case comment"
                    is_required: True
                    is_user_input: True

            outputs:
                "outcomeMessage": string
                    description: "Result message"
                    label: "Outcome message"
                    is_displayable: True
                    filter_from_agent: False
