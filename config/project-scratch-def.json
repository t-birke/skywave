            "enableUsersAreLightningOnly": "true",
            "enableLexEndUsersNoSwitching": "true"
        },
        "mobileSettings": {
            "enableS1EncryptedStoragePref2": "false"
        },
        "einsteinGptSettings": {
            "enableEinsteinGptPlatform": "true"
        },
        "botSettings": {
            "enableBots": true
        },
        "agentPlatformSettings": {
            "enableAgentPlatform": true
        },
        "communitiesSettings": {
            "enableNetworksEnabled": true
        },
        "customerDataPlatformSettings": {
            "enableCustomerDataPlatform": true
        },
        "knowledgeSettings": {
            "enableKnowledge": true,
            "enableLightningKnowledge": true
        },
        "omniChannelSettings": {
            "enableOmniChannel": true,
            "enableOmniSkillsRouting": true
        },
        "liveMessageSettings": {
            "enableLiveMessage": true
        }
    }
}