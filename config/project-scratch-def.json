{
    "orgName": "Skywave Scratch",
    "edition": "developer",
    "hasSampleData": false,
    "features": [
        "CustomerDataPlatform",
        "CustomerDataPlatformLite",
        "EnableSetPasswordInApi",
        "Chatbot",
        "Knowledge",
        "Einstein1AIPlatform",
        "Communities",
        "ServiceCloud",
        "LiveMessage",
        "LiveAgent"
    ],
    "settings": {
        "lightningExperienceSettings": {
