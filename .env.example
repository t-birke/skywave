# Skywave Interactive — environment variables
# Copy to .env and fill in. .env is gitignored. Never commit real values.

# === skywave-app (Heroku) ===

# Salesforce target org for the Heroku relay's JWT-bearer auth
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=
# Connected App "Skywave_Heroku_Relay" consumer key (Client ID).
# Find in Setup -> App Manager -> Skywave Heroku Relay -> View.
SF_CLIENT_ID=
# Private key paired with the public cert deployed via the Connected App.
# Generated by scripts/gen-jwt-keypair.sh into secrets/jwt.key.
# On Heroku, set as a config var: heroku config:set SF_JWT_PRIVATE_KEY="$(cat secrets/jwt.key)"
SF_JWT_PRIVATE_KEY=

# CORS-anywhere proxy used by the consumer site for guest-callable Apex.
# Tom's existing instance, same one electra uses (script.js:4).
CORS_PROXY_URL=https://abc-proxy-2552551e6d2c.herokuapp.com/

# Public Sites domain for guest-callable Apex REST on si
SF_SITE_BASE_URL=

# === Consumer-site front-end config (served via GET /api/config) ===

# Enhanced Messaging for Web v2 widget — values come from the org after the
# EmbeddedServiceConfig is published (see skywave-chat-embed notes).
SF_ESW_ORG_ID=
SF_ESW_ESC_NAME=
SF_ESW_SITE_URL=
SF_ESW_SCRT2_URL=

# Chat transport selector. 'ecv2' = official Embedded Service for Web v2 widget
# (requires chat.skywave.flights + app.skywave.flights on one registrable domain
# so the guest cookie is first-party). Unset / anything else = the custom scrt2
# REST client (portable, no shared domain needed). Default: miaw.
CHAT_CLIENT=

# Salesforce Interactions SDK (CDP). Only loaded when set; until then Apex
# mints the sessionId. Populated once the Web Connector exists in si Setup.
SF_INTERACTIONS_SDK_URL=

# ipinfo.io token for client-side IP geolocation (free tier). Served to the
# browser via /api/config; used to derive the visitor's home airport. The
# token is browser-exposed by design but kept out of git. See SECRETS.md.
# Geolocation silently no-ops if unset.
IPINFO_TOKEN=

# Node port (Heroku sets this automatically in production)
PORT=3000
