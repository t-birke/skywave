# Skywave Interactive — environment variables
# Copy to .env and fill in. .env is gitignored. Never commit real values.

# === skywave-app (Heroku) ===

# Salesforce target org for the Heroku relay's JWT-bearer auth
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=
# Connected App "Skywave_Heroku_Relay" consumer key (Client ID).
# Find in Setup -> App Manager -> Skywave Heroku Relay -> View.
SF_CLIENT_ID=
# Private key paired with the public cert deployed via the Connected App.
# Generated by scripts/gen-jwt-keypair.sh into secrets/jwt.key.
# On Heroku, set as a config var: heroku config:set SF_JWT_PRIVATE_KEY="$(cat secrets/jwt.key)"
SF_JWT_PRIVATE_KEY=

# CORS-anywhere proxy used by the consumer site for guest-callable Apex.
# Tom's existing instance, same one electra uses (script.js:4).
CORS_PROXY_URL=https://abc-proxy-2552551e6d2c.herokuapp.com/

# Public Sites domain for guest-callable Apex REST on si
SF_SITE_BASE_URL=

# Node port (Heroku sets this automatically in production)
PORT=3000
